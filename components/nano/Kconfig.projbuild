menu "Nano Cortex firmware"

config NANO_LOG_TUNER_ONLY
    bool "Serial: only nano_tuner INFO logs (suppress other INFO)"
    default n
    help
        Lowers the default log level for all tags to WARN, then re-enables
        INFO for the nano_tuner tag only. Warnings and errors still print.

config NANO_LOG_QUIET
    bool "Serial: quiet routine BLE/state INFO (keep FX Amount / focus)"
    default n
    help
        Sets nano_state and nano_ble tags to WARN so ROUTINE preset dumps,
        amp lines, and BLE chatter stay off the console. nano_fx INFO remains
        (Amount knob + pedal FX focus). Warnings and errors still print.

endmenu
