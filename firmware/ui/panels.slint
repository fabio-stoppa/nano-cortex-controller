import {
    Radius, Surface, ParamCell, HeaderButton, ScrollBar, ScrollFade,
    OptionRow, MidiRow, ExpressionRangeRow, ExpressionBypassRow, BtDevice,
    VCenter, PopupHeader, PopupTab, BluetoothList,
} from "common.slint";

export component SourceCard inherits Rectangle {
    in property <string> value;
    in property <string> slot;
    in property <bool> active: false;
    in property <bool> cab-icon: false;
    callback tapped();
    height: 78px;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    background: #000000;
    border-radius: Radius.default;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 9px;
        padding-right: 9px;
        spacing: 10px;
        VerticalLayout {
            width: 36px;
            height: 100%;
            alignment: center;
            Image {
                width: 36px;
                height: 36px;
                source: root.cab-icon ? @image-url("icons/cab.png") : @image-url("icons/capture.png");
                colorize: #ffffff;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 0px;
            HorizontalLayout {
                Text {
                    text: root.slot;
                    color: #858b90;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            // Grows with the name up to two lines, so slot and name stay centered as a group.
            Text {
                text: value;
                color: active ? #ececec : #74797d;
                font-size: 19px;
                font-weight: 700;
                height: min(self.preferred-height, 50px);
                min-width: 0px;
                preferred-width: 0px;
                overflow: elide;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
    TouchArea {
        clicked => { root.tapped(); }
    }
}

export component AmpPanel inherits Rectangle {
    in property <bool> portrait;
    in property <string> capture-title;
    in property <string> capture-value;
    in property <string> capture-slot;
    in property <bool> capture-active;
    in property <string> cab-value;
    in property <string> cab-slot;
    in property <bool> cab-active;
    in property <string> gate-text;
    in property <float> gate-amount;
    in property <string> gate-amnt-text;
    in property <float> gate-amnt-amount;
    in property <string> gain-text;
    in property <float> gain-amount;
    in property <string> cap-text;
    in property <float> cap-amount;
    in property <string> master-text;
    in property <float> master-amount;
    in property <string> bass-text;
    in property <float> bass-amount;
    in property <string> mid-text;
    in property <float> mid-amount;
    in property <string> treble-text;
    in property <float> treble-amount;
    in property <string> cab-output-text;
    in property <float> cab-output-amount;
    in property <string> cab-high-pass-text;
    in property <float> cab-high-pass-amount;
    in property <string> cab-low-pass-text;
    in property <float> cab-low-pass-amount;
    callback slider-moved(int, float);
    callback cab-slider-moved(int, float);
    callback gate-tapped();
    callback capture-tapped();
    callback cab-tapped();
    // Landscape rows shrink slightly so three rows with 8px gaps fit on screen.
    property <length> row-h: root.portrait ? 100px : 98px;
    property <length> cell-gap: 8px;
    property <length> card-height: root.portrait ? 78px
        : min(78px, root.height - 4px - 3 * root.row-h - 3 * root.cell-gap);
    background: transparent;
    HorizontalLayout {
        x: 2px;
        y: 0px;
        width: parent.width - 4px;
        height: root.card-height;
        spacing: root.cell-gap;
        SourceCard {
            height: root.card-height;
            value: root.capture-value;
            slot: root.capture-slot;
            active: root.capture-active;
            tapped => { root.capture-tapped(); }
        }
        SourceCard {
            height: root.card-height;
            value: root.cab-value;
            slot: root.cab-slot;
            active: root.cab-active;
            cab-icon: true;
            tapped => { root.cab-tapped(); }
        }
    }
    VerticalLayout {
        y: root.card-height + root.cell-gap - 2px;
        alignment: start;
        padding: 2px;
        spacing: root.cell-gap;
        if !root.portrait: HorizontalLayout {
            width: 100%;
            height: root.row-h;
            spacing: 8px;
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                name: "Input Gate";
                value: gate-text;
                amount: gate-amount;
                tapped => { root.gate-tapped(); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Gate Amnt";
                value: gate-amnt-text;
                amount: gate-amnt-amount;
                changed(v) => { root.slider-moved(6, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Gain";
                value: gain-text;
                amount: gain-amount;
                changed(v) => { root.slider-moved(0, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Capture Lv";
                value: cap-text;
                amount: cap-amount;
                changed(v) => { root.slider-moved(5, v); }
            }
        }
        if !root.portrait: HorizontalLayout {
            width: 100%;
            height: root.row-h;
            spacing: 8px;
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Master Lv";
                value: master-text;
                amount: master-amount;
                changed(v) => { root.slider-moved(1, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Bass";
                value: bass-text;
                amount: bass-amount;
                changed(v) => { root.slider-moved(2, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Mid";
                value: mid-text;
                amount: mid-amount;
                changed(v) => { root.slider-moved(3, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Treble";
                value: treble-text;
                amount: treble-amount;
                changed(v) => { root.slider-moved(4, v); }
            }
        }
        if root.portrait: HorizontalLayout {
            width: 100%;
            height: root.row-h;
            spacing: 8px;
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                name: "Input Gate";
                value: gate-text;
                amount: gate-amount;
                tapped => { root.gate-tapped(); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Gate Amnt";
                value: gate-amnt-text;
                amount: gate-amnt-amount;
                changed(v) => { root.slider-moved(6, v); }
            }
        }
        if root.portrait: HorizontalLayout {
            width: 100%;
            height: root.row-h;
            spacing: 8px;
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Capture Lv";
                value: cap-text;
                amount: cap-amount;
                changed(v) => { root.slider-moved(5, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Master Lv";
                value: master-text;
                amount: master-amount;
                changed(v) => { root.slider-moved(1, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Gain";
                value: gain-text;
                amount: gain-amount;
                changed(v) => { root.slider-moved(0, v); }
            }
        }
        if root.portrait: HorizontalLayout {
            width: 100%;
            height: root.row-h;
            spacing: 8px;
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Bass";
                value: bass-text;
                amount: bass-amount;
                changed(v) => { root.slider-moved(2, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Mid";
                value: mid-text;
                amount: mid-amount;
                changed(v) => { root.slider-moved(3, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: true;
                name: "Treble";
                value: treble-text;
                amount: treble-amount;
                changed(v) => { root.slider-moved(4, v); }
            }
        }
        HorizontalLayout {
            width: 100%;
            height: root.row-h;
            spacing: 8px;
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: root.cab-active;
                name: "Cab Output";
                value: root.cab-output-text;
                amount: root.cab-output-amount;
                changed(v) => { root.cab-slider-moved(0, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: root.cab-active;
                name: "High Pass";
                value: root.cab-high-pass-text;
                amount: root.cab-high-pass-amount;
                changed(v) => { root.cab-slider-moved(1, v); }
            }
            ParamCell {
                height: root.row-h;
                horizontal-stretch: 1;
                slider: root.cab-active;
                name: "Low Pass";
                value: root.cab-low-pass-text;
                amount: root.cab-low-pass-amount;
                changed(v) => { root.cab-slider-moved(2, v); }
            }
            if !root.portrait: Rectangle {
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
            }
        }
    }
}

export component FxParamCell inherits ParamCell {
    label-font-size: 19px;
}

export component FxPanel inherits Rectangle {
    in property <bool> portrait: false;
    in property <string> n0;
    in property <string> v0;
    in property <float> a0;
    in property <string> n1;
    in property <string> v1;
    in property <float> a1;
    in property <string> n2;
    in property <string> v2;
    in property <float> a2;
    in property <string> n3;
    in property <string> v3;
    in property <float> a3;
    in property <string> n4;
    in property <string> v4;
    in property <float> a4;
    in property <string> n5;
    in property <string> v5;
    in property <float> a5;
    in property <string> n6;
    in property <string> v6;
    in property <float> a6;
    in property <string> n7;
    in property <string> v7;
    in property <float> a7;
    in property <string> n8;
    in property <string> v8;
    in property <float> a8;
    in property <string> n9;
    in property <string> v9;
    in property <float> a9;
    in property <string> n10;
    in property <string> v10;
    in property <float> a10;
    in property <string> n11;
    in property <string> v11;
    in property <float> a11;
    in property <string> n12;
    in property <string> v12;
    in property <float> a12;
    in property <string> n13;
    in property <string> v13;
    in property <float> a13;
    in property <string> n14;
    in property <string> v14;
    in property <float> a14;
    in property <string> n15;
    in property <string> v15;
    in property <float> a15;
    in property <string> n16;
    in property <string> v16;
    in property <float> a16;
    in property <string> n17;
    in property <string> v17;
    in property <float> a17;
    in property <string> n18;
    in property <string> v18;
    in property <float> a18;
    in property <string> n19;
    in property <string> v19;
    in property <float> a19;
    in property <string> n20;
    in property <string> v20;
    in property <float> a20;
    in property <string> n21;
    in property <string> v21;
    in property <float> a21;
    in property <string> n22;
    in property <string> v22;
    in property <float> a22;
    in property <string> n23;
    in property <string> v23;
    in property <float> a23;
    in property <string> model-name: "-";
    in property <bool> model-enabled: false;
    callback model-list-tapped();
    callback model-stepped(int);
    callback param-changed(int, float);
    property <int> columns: root.portrait ? 3 : 4;
    property <[string]> names: [root.n0, root.n1, root.n2, root.n3, root.n4, root.n5,
        root.n6, root.n7, root.n8, root.n9, root.n10, root.n11, root.n12, root.n13,
        root.n14, root.n15, root.n16, root.n17, root.n18, root.n19, root.n20,
        root.n21, root.n22, root.n23];
    property <[string]> values: [root.v0, root.v1, root.v2, root.v3, root.v4, root.v5,
        root.v6, root.v7, root.v8, root.v9, root.v10, root.v11, root.v12, root.v13,
        root.v14, root.v15, root.v16, root.v17, root.v18, root.v19, root.v20,
        root.v21, root.v22, root.v23];
    property <[float]> amounts: [root.a0, root.a1, root.a2, root.a3, root.a4, root.a5,
        root.a6, root.a7, root.a8, root.a9, root.a10, root.a11, root.a12, root.a13,
        root.a14, root.a15, root.a16, root.a17, root.a18, root.a19, root.a20,
        root.a21, root.a22, root.a23];
    property <length> cell-width: (root.width - 4px - (root.columns - 1) * 8px) / root.columns;
    background: transparent;
    clip: true;
    Flickable {
        y: 0px;
        width: 100%;
        height: root.height;
        viewport-y: 0px;
        VerticalLayout {
            width: parent.width;
            alignment: start;
            padding: 2px;
            padding-top: 0px;
            spacing: 8px;
            for row in 24 / root.columns: HorizontalLayout {
                property <int> first: row * root.columns;
                property <bool> populated: root.names[self.first] != "-" || root.names[self.first + 1] != "-"
                    || root.names[self.first + 2] != "-" || (root.columns == 4 && root.names[self.first + 3] != "-");
                height: self.populated ? 100px : 0px;
                visible: self.populated;
                spacing: 8px;
                alignment: start;
                for column in root.columns: FxParamCell {
                    property <int> index: row * root.columns + column;
                    visible: root.names[self.index] != "-";
                    width: self.visible ? root.cell-width : 0px;
                    height: 100px;
                    horizontal-stretch: 0;
                    slider: true;
                    name: root.names[self.index];
                    value: root.values[self.index];
                    amount: root.amounts[self.index];
                    changed(v) => { root.param-changed(self.index, v); }
                }
            }
        }
    }
}

export component TunerPanel inherits Rectangle {
    in property <bool> portrait: false;
    in property <string> note;
    in property <string> cents;
    in property <string> reference;
    in property <float> reference-hz: 440;
    in property <float> cents-pos: 0.5;
    in property <bool> has-pitch: false;
    in property <bool> in-tune: false;
    in property <bool> active;
    in property <bool> muted: false;
    callback tuner-tapped();
    callback reference-set(int);
    callback mute-tapped();
    property <color> note-color: !has-pitch ? #9a9a9a : (in-tune ? #45f862 : #ffffff);
    background: #1e1e1e;
    TouchArea {}

    Image {
        x: (parent.width - self.width) / 2;
        y: 12px;
        width: 36px;
        height: 21px;
        source: @image-url("icons/triangle.png");
        colorize: #1af858;
    }
    Rectangle {
        x: 12px;
        y: 34px;
        width: parent.width - 24px;
        height: 64px;
        for i in 41: Rectangle {
            x: i * (parent.width - 7px) / 40;
            y: (parent.height - self.height) / 2;
            width: 7px;
            height: i == 20 ? 0px : 18px + 46px * (1 - abs(i - 20) / 20);
            background: mod(i, 2) == 0 ? #4a4a4a : #333333;
            border-radius: 3.5px;
        }
        Rectangle {
            x: (parent.width - 9px) * cents-pos;
            y: 0px;
            width: 9px;
            height: 100%;
            visible: has-pitch;
            background: note-color;
            border-radius: 2px;
        }
    }

    Text {
        y: 134px;
        width: parent.width;
        height: parent.height - 218px;
        text: root.note;
        color: root.note-color;
        font-family: "IBM Plex Sans";
        font-size: 210px;
        font-weight: 900;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        y: 110px;
        width: parent.width;
        height: 40px;
        text: cents;
        color: #9a9a9a;
        font-size: 26px;
        font-weight: 900;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 56px;
        width: parent.width;
        height: 56px;

        Rectangle {
            x: 0px;
            width: root.portrait ? 140px : 200px;
            height: 56px;
            y: (parent.height - self.height) / 2;
            Rectangle {
                x: 0px;
                width: 56px;
                height: 32px;
                y: (parent.height - self.height) / 2;
                background: muted ? #1a3af8 : #505050;
                border-radius: 16px;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    x: muted ? 28px : 4px;
                    y: 4px;
                    background: #ffffff;
                    border-radius: 12px;
                }
            }
            Text {
                x: 68px;
                height: 100%;
                text: "MUTE";
                color: #f2f2f2;
                font-size: 22px;
                font-weight: 900;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.mute-tapped(); }
            }
        }

        ParamCell {
            x: root.portrait ? 148px : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.portrait ? max(0px, parent.width - 252px) : 300px;
            height: 56px;
            slider: true;
            bare: true;
            value-first: false;
            name: "Hz Ref";
            value: root.reference;
            amount: max(0, min(1, (root.reference-hz - 400) / 80));
            changed(v) => { root.reference-set(round(400 + 80 * v)); }
            double-tapped => { root.reference-set(440); }
        }

        Rectangle {
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            width: root.portrait ? 96px : 140px;
            height: 56px;
            background: #000000;
            border-radius: Radius.default;
            Text {
                text: "EXIT";
                color: #f2f2f2;
                font-size: 22px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.tuner-tapped(); }
            }
        }
    }
}

export component MeterRow inherits OptionRow {
    in property <float> amount;
    in property <string> reading;
    in property <bool> interactive: false;
    in property <float> default-amount: 1.0;
    callback released(float);
    pure callback preview-text(float) -> string;
    property <float> drag: 0;
    property <bool> dragging: false;
    property <float> shown: root.dragging ? root.drag : root.amount;
    Rectangle {
        horizontal-stretch: 2;
        min-width: 0px;
        preferred-width: 0px;
        track := Rectangle {
            height: root.interactive ? 18px : 8px;
            background: root.interactive ? #1e1e1e : #333333;
            border-color: #707070;
            border-width: root.interactive ? 1px : 0px;
            border-radius: root.interactive ? 3px : 4px;
            Rectangle {
                x: 0px;
                width: parent.width * root.shown;
                height: 100%;
                background: root.interactive ? #b8c0c8 : #1a3af8;
                border-radius: root.interactive ? 2px : 4px;
            }
            if root.interactive: TouchArea {
                y: -19px;
                height: 56px;
                double-clicked => { root.released(root.default-amount); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.dragging = true;
                        root.drag = clamp(self.mouse-x / self.width, 0, 1);
                    } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        root.dragging = false;
                        root.released(root.drag);
                    }
                }
                moved => {
                    if self.pressed { root.drag = clamp(self.mouse-x / self.width, 0, 1); }
                }
            }
        }
    }
    Text {
        text: root.dragging ? root.preview-text(root.drag) : root.reading;
        color: #ececec;
        font-size: 18px;
        font-weight: 700;
        width: 84px;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

export component MidiPanel inherits Rectangle {
    in property <[MidiRow]> rows;
    in property <int> tab: 0;
    in property <string> notice;
    changed tab => { midi-list.viewport-y = 0px; }
    callback learn(int);
    callback clear(int);
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        if root.notice != "": Text {
            text: root.notice;
            color: #ececec;
            font-size: 16px;
            height: 28px;
        }
        midi-list := Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: root.rows.length * 76px;
            property <int> first-row: min(max(0, root.rows.length - 1), max(0, floor(-self.viewport-y / 76px)));
            property <int> visible-rows: min(root.rows.length - self.first-row, ceil(self.height / 76px) + 1);
            for offset in midi-list.visible-rows: action-row := OptionRow {
                property <int> action-index: midi-list.first-row + offset;
                property <MidiRow> action: root.rows[self.action-index];
                x: 0px;
                y: self.action-index * 76px;
                width: midi-list.width - (midi-list.viewport-height > midi-list.height ? 16px : 0px);
                label: self.action.name;
                value: self.action.learning ? "Waiting..." : (self.action.assigned == "" ? "-" : self.action.assigned);
                highlight: self.action.learning;
                VCenter { HeaderButton {
                    label: action-row.action.learning ? "Cancel" : "Learn";
                    preferred-width: 104px;
                    min-width: 104px;
                    hot: !action-row.action.learning;
                    light: action-row.action.learning;
                    tapped => { root.learn(action-row.action.index); }
                } }
                VCenter { HeaderButton {
                    label: "Clear";
                    preferred-width: 104px;
                    min-width: 104px;
                    tapped => { root.clear(action-row.action.index); }
                } }
            }
            ScrollFade {
                width: midi-list.width;
                offset: -midi-list.viewport-y;
                page: midi-list.height;
                total: midi-list.viewport-height;
            }
            ScrollBar {
                x: midi-list.width - 6px;
                offset: -midi-list.viewport-y;
                page: midi-list.height;
                total: midi-list.viewport-height;
            }
        }
    }
}

export component SwitchToggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 56px;
    height: 30px;
    background: root.on ? #1a3af8 : #505050;
    border-radius: 15px;
    Rectangle {
        width: 24px;
        height: 24px;
        x: root.on ? 29px : 3px;
        y: 3px;
        background: #ffffff;
        border-radius: 12px;
        animate x { duration: 120ms; }
    }
    TouchArea { clicked => { root.on = !root.on; root.toggled(root.on); } }
}

export component ToolsPanel inherits Rectangle {
    in property <bool> autosave-enabled;
    in property <bool> remember-last-mode;
    in property <[string]> eq-trim-values;
    in property <bool> eq-trim-enabled;
    in property <int> eq-trim-preset;
    in property <string> autosave-status;
    callback autosave-toggled(bool);
    callback remember-last-mode-toggled(bool);
    callback eq-trim-adjusted(int, int);
    in property <string> jack-mode;
    in property <bool> jack-expression;
    in property <string> usb-level;
    in property <float> usb-amount;
    callback usb-set(float);
    in-out property <bool> mute-input;
    in-out property <bool> mute-output;
    callback mute-set(bool, bool);
    in property <string> cab-settings;
    in property <string> expression-summary;
    in property <[ExpressionRangeRow]> expression-ranges;
    in property <[ExpressionBypassRow]> expression-bypasses;
    in property <string> calibration-status;
    in property <string> protocol-status;
    in-out property <bool> tempo-global: true;
    in property <string> meter-input;
    in property <string> meter-output;
    in property <string> meter-expression;
    in property <float> meter-input-amount;
    in property <float> meter-output-amount;
    in property <float> meter-expression-amount;
    callback closed();
    in-out property <int> tab: 0;
    in property <int> section: 0;
    in-out property <int> pedal-tab: 0;
    in-out property <int> midi-tab: 0;
    in property <[BtDevice]> bt-devices;
    callback bt-picked(int);
    callback bt-forget(int);
    callback bt-choose-another();
    in property <int> layout-mode;
    callback layout-tapped(int);
    in property <[MidiRow]> midi-rows;
    in property <string> midi-notice;
    callback midi-learn(int);
    callback midi-clear(int);
    callback clear-requested(int);
    callback usb-storage();
    in property <bool> scene-library-busy;
    in property <bool> save-dirty;
    callback save();
    callback refresh();
    callback tuner();
    callback jack-selected(bool);
    callback calibration-start();
    callback calibration-save();
    callback expression-range-toggle(int);
    callback expression-range-adjust(int, int, int);
    callback expression-bypass-toggle(int);
    callback expression-bypass-adjust(int, int);
    callback expression-save();
    background: Surface.background;
    TouchArea {}
    Rectangle {
        width: root.width;
        height: root.height;
        background: Surface.background;
        TouchArea {}
        VerticalLayout {
            padding: Surface.screen-margin;
            spacing: 7px;
            PopupHeader {
                title: root.section == 1 ? "Pedals" : root.section == 2 ? "MIDI" : "Settings";
                closed => { root.closed(); }
                settings-flick := Flickable {
                    x: parent.tabs-x;
                    width: parent.tabs-width;
                    height: parent.height;
                    viewport-width: max(self.width, settings-tabs.preferred-width);
                    settings-tabs := HorizontalLayout {
                        x: 0px;
                        height: parent.height;
                        width: max(settings-flick.width, self.preferred-width);
                        alignment: end;
                        spacing: 0px;
                        for name[i] in (root.section == 1 ? ["General", "Sweeps", "Bypass", "Calibration"]
                            : root.section == 2 ? ["Controls", "Presets 1-16", "Presets 17-32",
                                "Presets 33-48", "Presets 49-64", "Captures", "Scenes/Gig",
                                "Amp/Cab", "FX switches/models",
                                "Pre FX 1", "Pre FX 2", "Post FX 1", "Post FX 2", "Post FX 3"]
                            : ["General", "Audio", "Bluetooth"]): PopupTab {
                            label: name;
                            active: root.section == 1 ? i == root.pedal-tab
                                : root.section == 2 ? i == root.midi-tab
                                : (i == 0 ? 0 : i == 1 ? 2 : 4) == root.tab;
                            tapped => {
                                if root.section == 1 { root.pedal-tab = i; }
                                else if root.section == 2 { root.midi-tab = i; }
                                else { root.tab = i == 0 ? 0 : i == 1 ? 2 : 4; }
                            }
                        }
                    }
                }
                Rectangle {
                    x: parent.tabs-x;
                    width: 28px;
                    height: parent.height - 4px;
                    visible: settings-flick.viewport-x < -1px;
                    background: @linear-gradient(90deg, #1e1e1e 0%, #1e1e1e00 100%);
                }
                Rectangle {
                    x: parent.tabs-x + parent.tabs-width - 28px;
                    width: 28px;
                    height: parent.height - 4px;
                    visible: settings-flick.viewport-x + settings-flick.width < settings-flick.viewport-width - 1px;
                    background: @linear-gradient(90deg, #1e1e1e00 0%, #1e1e1e 100%);
                }
            }
            Rectangle { height: 2px; }
            if root.section != 2: settings-scroll := Flickable {
                property <int> tab-key: root.section == 1 ? root.pedal-tab : root.tab;
                changed tab-key => { self.viewport-y = 0px; }
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: settings-body.preferred-height;
                settings-body := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: settings-scroll.width - (settings-body.preferred-height > settings-scroll.height ? 16px : 0px);
                    if root.section == 0 && root.tab == 4: BluetoothList {
                        devices: root.bt-devices;
                        picked(index) => { root.bt-picked(index); }
                        forget(index) => { root.bt-forget(index); }
                        choose-another => { root.bt-choose-another(); }
                    }
                    if root.section == 0 && root.tab == 0: VerticalLayout {
                        spacing: 8px;
                        OptionRow {
                            label: "Global tempo";
                            VCenter {
                                Rectangle {
                                    width: 56px;
                                    height: 30px;
                                    background: root.tempo-global ? #1a3af8 : #505050;
                                    border-radius: 15px;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        x: root.tempo-global ? 29px : 3px;
                                        y: 3px;
                                        background: #ffffff;
                                        border-radius: 12px;
                                        animate x { duration: 120ms; }
                                    }
                                    TouchArea { clicked => { root.tempo-global = !root.tempo-global; } }
                                }
                            }
                        }
                        OptionRow {
                            label: "Screen";
                            VCenter { HeaderButton { label: "Land"; choice: true; hot: root.layout-mode == 0; tapped => { root.layout-tapped(0); } } }
                            VCenter { HeaderButton { label: "Land flip"; choice: true; hot: root.layout-mode == 3; tapped => { root.layout-tapped(3); } } }
                            VCenter { HeaderButton { label: "Port"; choice: true; hot: root.layout-mode == 1; tapped => { root.layout-tapped(1); } } }
                            VCenter { HeaderButton { label: "Port flip"; choice: true; hot: root.layout-mode == 2; tapped => { root.layout-tapped(2); } } }
                        }
                        OptionRow {
                            label: "Autosave scenes";
                            VCenter {
                                Rectangle {
                                    width: 56px;
                                    height: 30px;
                                    background: root.autosave-enabled ? #1a3af8 : #505050;
                                    border-radius: 15px;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        x: root.autosave-enabled ? 29px : 3px;
                                        y: 3px;
                                        background: #ffffff;
                                        border-radius: 12px;
                                        animate x { duration: 120ms; }
                                    }
                                    TouchArea { clicked => { root.autosave-toggled(!root.autosave-enabled); } }
                                }
                            }
                        }
                        OptionRow {
                            label: "Remember last mode";
                            VCenter {
                                SwitchToggle {
                                    on: root.remember-last-mode;
                                    toggled(enabled) => { root.remember-last-mode-toggled(enabled); }
                                }
                            }
                        }
                        OptionRow {
                            label: "Preset " + root.eq-trim-preset + " EQ trim";
                            VCenter {
                                HeaderButton {
                                    label: "Reset";
                                    enabled: root.eq-trim-enabled;
                                    tapped => { root.eq-trim-adjusted(3, 0); }
                                }
                            }
                        }
                        for label[index] in ["Bass trim", "Mid trim", "Treble trim"]: OptionRow {
                            label: label;
                            VCenter {
                                HeaderButton {
                                    label: "-";
                                    enabled: root.eq-trim-enabled;
                                    tapped => { root.eq-trim-adjusted(index, -1); }
                                }
                            }
                            VCenter {
                                width: 72px;
                                horizontal-stretch: 0;
                                Text {
                                    text: root.eq-trim-values[index];
                                    color: #ffffff;
                                    font-size: 24px;
                                    horizontal-alignment: center;
                                }
                            }
                            VCenter {
                                HeaderButton {
                                    label: "+";
                                    enabled: root.eq-trim-enabled;
                                    tapped => { root.eq-trim-adjusted(index, 1); }
                                }
                            }
                        }
                        if root.autosave-status != "": Rectangle {
                            height: 48px;
                            background: transparent;
                            Text {
                                text: root.autosave-status;
                                color: #ececec;
                                font-size: 16px;
                                wrap: word-wrap;
                            }
                        }
                        OptionRow {
                            label: "Configuration";
                            VCenter {
                                HeaderButton {
                                    label: "USB drive";
                                    enabled: !root.scene-library-busy;
                                    tapped => { root.usb-storage(); }
                                }
                            }
                        }
                        OptionRow {
                            label: "Tools";
                            VCenter { horizontal-stretch: 0; HeaderButton { label: "Tuner"; tapped => { root.tuner(); } } }
                            VCenter { horizontal-stretch: 0; HeaderButton { label: "Refresh"; tapped => { root.refresh(); } } }
                            VCenter { horizontal-stretch: 0; HeaderButton { label: "Save"; hot: root.save-dirty; tapped => { root.save(); } } }
                        }
                        OptionRow {
                            label: "Clear";
                            for label[i] in ["MIDI", "Scenes", "Preferences"]: VCenter {
                                width: i == 2 ? 128px : 80px;
                                horizontal-stretch: 0;
                                HeaderButton {
                                    label: label;
                                    min-width: 0px;
                                    preferred-width: i == 2 ? 128px : 80px;
                                    enabled: i != 1 || !root.scene-library-busy;
                                    tapped => { root.clear-requested(i + 1); }
                                }
                            }
                        }
                    }
                    if root.section == 1: VerticalLayout {
                        spacing: 8px;
                        if root.pedal-tab == 0: OptionRow {
                            label: "Jack";
                            value: root.jack-mode;
                            VCenter { HeaderButton {
                                label: root.jack-expression ? "Use MIDI" : "Use EXP";
                                tapped => { root.jack-selected(!root.jack-expression); }
                            } }
                        }
                        if root.pedal-tab == 0: OptionRow {
                            label: "Expression";
                            value: root.expression-summary;
                        }
                        if root.pedal-tab == 1 || root.pedal-tab == 2: OptionRow {
                            label: "Sweep assignments";
                            VCenter {
                                HeaderButton {
                                    label: "Save";
                                    hot: root.expression-summary != "Not loaded";
                                    tapped => { root.expression-save(); }
                                }
                            }
                        }
                        if root.pedal-tab == 1 || root.pedal-tab == 2: Text {
                            text: "Adjust heel/toe in 5% steps. Bypass modes support delay, inversion and switch latch.";
                            color: #909090;
                            font-size: 14px;
                            height: 28px;
                            vertical-alignment: center;
                        }
                        if root.pedal-tab == 1: VerticalLayout {
                            spacing: 8px;
                            for row in root.expression-ranges: OptionRow {
                                label: row.name;
                                value: row.summary;
                                VCenter { HeaderButton {
                                    label: row.enabled ? "On" : "Off";
                                    hot: row.enabled;
                                    tapped => { root.expression-range-toggle(row.target); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: "Min −";
                                    tapped => { root.expression-range-adjust(row.target, 0, -1); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: "Min +";
                                    tapped => { root.expression-range-adjust(row.target, 0, 1); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: "Max −";
                                    tapped => { root.expression-range-adjust(row.target, 1, -1); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: "Max +";
                                    tapped => { root.expression-range-adjust(row.target, 1, 1); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: row.inverted ? "Rev" : "Norm";
                                    choice: true;
                                    hot: row.inverted;
                                    tapped => { root.expression-range-adjust(row.target, 2, 0); }
                                } }
                            }
                        }
                        if root.pedal-tab == 2: VerticalLayout {
                            spacing: 8px;
                            for row in root.expression-bypasses: OptionRow {
                                label: row.name + " switch";
                                value: row.summary;
                                VCenter { HeaderButton {
                                    label: row.enabled ? "On" : "Off";
                                    hot: row.enabled;
                                    tapped => { root.expression-bypass-toggle(row.target); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: row.mode == 0 ? "Heel/toe" : (row.mode == 1 ? "Switch" : "Stop");
                                    choice: true;
                                    tapped => { root.expression-bypass-adjust(row.target, 0); }
                                } }
                                if row.enabled && row.mode != 1: VCenter { HeaderButton {
                                    label: "Delay −";
                                    tapped => { root.expression-bypass-adjust(row.target, 1); }
                                } }
                                if row.enabled && row.mode != 1: VCenter { HeaderButton {
                                    label: "Delay +";
                                    tapped => { root.expression-bypass-adjust(row.target, 2); }
                                } }
                                if row.enabled && row.mode != 2: VCenter { HeaderButton {
                                    label: row.inverted ? "Rev" : "Norm";
                                    choice: true;
                                    hot: row.inverted;
                                    tapped => { root.expression-bypass-adjust(row.target, 3); }
                                } }
                                if row.enabled && row.mode == 1: VCenter { HeaderButton {
                                    label: row.latch ? "Latch" : "Momentary";
                                    choice: true;
                                    hot: row.latch;
                                    tapped => { root.expression-bypass-adjust(row.target, 4); }
                                } }
                            }
                        }
                        if root.pedal-tab == 3: OptionRow {
                            label: "Calibration";
                            value: root.calibration-status;
                            VCenter { HeaderButton { label: "Start"; tapped => { root.calibration-start(); } } }
                            VCenter { HeaderButton { label: "Save"; tapped => { root.calibration-save(); } } }
                        }
                        if root.pedal-tab == 3: Text {
                            text: "Start clears the saved range. Sweep heel-to-toe, then save.";
                            color: #909090;
                            font-size: 14px;
                            height: 28px;
                            vertical-alignment: center;
                        }
                    }
                    if root.section == 0 && root.tab == 2: VerticalLayout {
                        spacing: 8px;
                        MeterRow {
                            label-width: 170px;
                            label: "USB level";
                            reading: root.usb-level;
                            amount: root.usb-amount;
                            interactive: true;
                            preview-text(a) => { return round(-40 + a * 40) + " dB"; }
                            released(a) => { root.usb-set(a); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            OptionRow {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                label: "Mute input";
                                VCenter { SwitchToggle { on <=> root.mute-input; toggled(m) => { root.mute-set(true, m); } } }
                            }
                            OptionRow {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                label: "Mute output";
                                VCenter { SwitchToggle { on <=> root.mute-output; toggled(m) => { root.mute-set(false, m); } } }
                            }
                        }
                        MeterRow {
                            label-width: 170px;
                            label: "Capture in";
                            reading: root.meter-input;
                            amount: root.meter-input-amount;
                        }
                        MeterRow {
                            label-width: 170px;
                            label: "Capture out";
                            reading: root.meter-output;
                            amount: root.meter-output-amount;
                        }
                        MeterRow {
                            label-width: 170px;
                            label: "Expression";
                            reading: root.meter-expression;
                            amount: root.meter-expression-amount;
                        }
                    }
                }
                ScrollFade {
                    width: settings-scroll.width;
                    offset: -settings-scroll.viewport-y;
                    page: settings-scroll.height;
                    total: settings-scroll.viewport-height;
                }
                ScrollBar {
                    x: settings-scroll.width - 6px;
                    offset: -settings-scroll.viewport-y;
                    page: settings-scroll.height;
                    total: settings-scroll.viewport-height;
                }
            }
            if root.section == 2: MidiPanel {
                rows: root.midi-rows;
                tab: root.midi-tab;
                notice: root.midi-notice;
                vertical-stretch: 100;
                learn(index) => { root.midi-learn(index); }
                clear(index) => { root.midi-clear(index); }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }

}


// One device's connection state: dot, name and status text.
