    in property <string> n20;
    in property <string> v20;
    in property <float> a20;
    in property <string> n21;
    in property <string> v21;
    in property <float> a21;
    in property <string> n22;
    in property <string> v22;
    in property <float> a22;
    in property <string> n23;
    in property <string> v23;
    in property <float> a23;
    in property <string> model-name: "-";
    in property <bool> model-enabled: false;
    callback model-list-tapped();
    callback model-stepped(int);
    callback param-changed(int, float);
    property <length> cell-width: (root.width - 4px - 12px) / 4;
    background: transparent;
    clip: true;
    Flickable {
        width: 100%;
        height: 100%;
        viewport-y: 0px;
        VerticalLayout {
            width: parent.width;
            alignment: start;
            padding: 2px;
            spacing: 4px;
            if root.n0 != "-" || root.n1 != "-" || root.n2 != "-" || root.n3 != "-": HorizontalLayout {
                width: 100%;
                spacing: 4px;
                alignment: start;
                if root.n0 != "-": ParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n0; value: root.v0; amount: root.a0;
                    changed(v) => { root.param-changed(0, v); }
                }
                if root.n1 != "-": ParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n1; value: root.v1; amount: root.a1;
                    changed(v) => { root.param-changed(1, v); }
                }
                if root.n2 != "-": ParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n2; value: root.v2; amount: root.a2;
                    changed(v) => { root.param-changed(2, v); }
                }
                if root.n3 != "-": ParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n3; value: root.v3; amount: root.a3;
                    changed(v) => { root.param-changed(3, v); }
                }
            }
            if root.n4 != "-" || root.n5 != "-" || root.n6 != "-" || root.n7 != "-": HorizontalLayout {
                width: 100%;
                spacing: 4px;
                alignment: start;
                if root.n4 != "-": ParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n4; value: root.v4; amount: root.a4;
                    changed(v) => { root.param-changed(4, v); }
                }
                if root.n5 != "-": ParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n5; value: root.v5; amount: root.a5;
                    changed(v) => { root.param-changed(5, v); }
                }
                if root.n6 != "-": ParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n6; value: root.v6; amount: root.a6;
                    changed(v) => { root.param-changed(6, v); }
                }
                if root.n7 != "-": ParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n7; value: root.v7; amount: root.a7;
                    changed(v) => { root.param-changed(7, v); }
                }
            }
            if root.n8 != "-" || root.n9 != "-" || root.n10 != "-" || root.n11 != "-": HorizontalLayout {
                width: 100%;
                spacing: 4px;
                alignment: start;
                if root.n8 != "-": ParamCell {
