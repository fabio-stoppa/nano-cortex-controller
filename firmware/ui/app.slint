component TunerPanel inherits Rectangle {
    in property <string> note;
    in property <string> cents;
    in property <string> reference;
    in property <float> reference-hz: 440;
    in property <float> cents-pos: 0.5;
    in property <bool> has-pitch: false;
    in property <bool> in-tune: false;
    in property <bool> active;
    in property <bool> muted: false;
    callback tuner-tapped();
    callback reference-set(int);
    callback mute-tapped();
    property <color> note-color: !has-pitch ? #9a9a9a : (in-tune ? #45f862 : #ffffff);
    background: #1e1e1e;
    TouchArea {}

    Image {
        x: (parent.width - self.width) / 2;
        y: 12px;
        width: 36px;
        height: 21px;
        source: @image-url("icons/triangle.png");
        colorize: #1af858;
    }
    Rectangle {
        x: 12px;
        y: 34px;
        width: parent.width - 24px;
        height: 64px;
        for i in 41: Rectangle {
            x: i * (parent.width - 7px) / 40;
            y: (parent.height - self.height) / 2;
            width: 7px;
            height: i == 20 ? 0px : 18px + 46px * (1 - abs(i - 20) / 20);
            background: mod(i, 2) == 0 ? #4a4a4a : #333333;
            border-radius: 3.5px;
        }
        Rectangle {
            x: (parent.width - 9px) * cents-pos;
            y: 0px;
            width: 9px;
            height: 100%;
            visible: has-pitch;
            background: note-color;
            border-radius: 2px;
        }
    }

    Text {
        y: 134px;
        width: parent.width;
        height: parent.height - 218px;
        text: root.note;
        color: root.note-color;
        font-family: "IBM Plex Sans";
        font-size: 210px;
        font-weight: 900;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        y: 110px;
        width: parent.width;
        height: 40px;
        text: cents;
        color: #9a9a9a;
        font-size: 26px;
        font-weight: 900;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        y: parent.height - 56px;
        width: parent.width;
        height: 56px;

        Rectangle {
            x: 0px;
            width: 200px;
            height: 56px;
            y: (parent.height - self.height) / 2;
            Rectangle {
                x: 0px;
                width: 56px;
                height: 32px;
                y: (parent.height - self.height) / 2;
                background: muted ? #1a3af8 : #505050;
                border-radius: 16px;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    x: muted ? 28px : 4px;
                    y: 4px;
                    background: #ffffff;
                    border-radius: 12px;
                }
            }
            Text {
                x: 68px;
                height: 100%;
                text: "MUTE";
                color: #f2f2f2;
                font-size: 22px;
                font-weight: 900;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.mute-tapped(); }
            }
        }

        ParamCell {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 300px;
            height: 56px;
            slider: true;
            bare: true;
            value-first: false;
            name: "Hz Ref";
            value: root.reference;
            amount: max(0, min(1, (root.reference-hz - 400) / 80));
            changed(v) => { root.reference-set(round(400 + 80 * v)); }
            double-tapped => { root.reference-set(440); }
        }

        Rectangle {
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            width: 140px;
            height: 56px;
            background: #000000;
            border-radius: Radius.default;
            Text {
                text: "EXIT";
                color: #f2f2f2;
                font-size: 22px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.tuner-tapped(); }
            }
        }
    }
}

component MeterRow inherits OptionRow {
    in property <float> amount;
    in property <string> reading;
    in property <bool> interactive: false;
    in property <float> default-amount: 1.0;
    callback released(float);
    pure callback preview-text(float) -> string;
    property <float> drag: 0;
    property <bool> dragging: false;
    property <float> shown: root.dragging ? root.drag : root.amount;
    Rectangle {
        horizontal-stretch: 2;
        min-width: 0px;
        preferred-width: 0px;
        track := Rectangle {
            height: root.interactive ? 18px : 8px;
            background: root.interactive ? #1e1e1e : #333333;
            border-color: #707070;
            border-width: root.interactive ? 1px : 0px;
            border-radius: root.interactive ? 3px : 4px;
            Rectangle {
                x: 0px;
                width: parent.width * root.shown;
                height: 100%;
                background: root.interactive ? #b8c0c8 : #1a3af8;
                border-radius: root.interactive ? 2px : 4px;
            }
            if root.interactive: TouchArea {
                y: -19px;
                height: 56px;
                double-clicked => { root.released(root.default-amount); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.dragging = true;
                        root.drag = clamp(self.mouse-x / self.width, 0, 1);
                    } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        root.dragging = false;
                        root.released(root.drag);
                    }
                }
                moved => {
                    if self.pressed { root.drag = clamp(self.mouse-x / self.width, 0, 1); }
                }
            }
        }
    }
    Text {
        text: root.dragging ? root.preview-text(root.drag) : root.reading;
        color: #ececec;
        font-size: 18px;
        font-weight: 700;
        width: 84px;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

component MidiPanel inherits Rectangle {
    in property <[MidiRow]> rows;
    in property <int> tab: 0;
    in property <string> notice;
    changed tab => { midi-list.viewport-y = 0px; }
    callback learn(int);
    callback clear(int);
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        if root.notice != "": Text {
            text: root.notice;
            color: #ececec;
            font-size: 16px;
            height: 28px;
        }
        midi-list := Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: root.rows.length * 76px;
            property <int> first-row: min(max(0, root.rows.length - 1), max(0, floor(-self.viewport-y / 76px)));
            property <int> visible-rows: min(root.rows.length - self.first-row, ceil(self.height / 76px) + 1);
            for offset in midi-list.visible-rows: action-row := OptionRow {
                property <int> action-index: midi-list.first-row + offset;
                property <MidiRow> action: root.rows[self.action-index];
                x: 0px;
                y: self.action-index * 76px;
                width: midi-list.width - (midi-list.viewport-height > midi-list.height ? 16px : 0px);
                label: self.action.name;
                value: self.action.learning ? "Waiting..." : (self.action.assigned == "" ? "-" : self.action.assigned);
                highlight: self.action.learning;
                VCenter { HeaderButton {
                    label: action-row.action.learning ? "Cancel" : "Learn";
                    preferred-width: 104px;
                    min-width: 104px;
                    hot: !action-row.action.learning;
                    light: action-row.action.learning;
                    tapped => { root.learn(action-row.action.index); }
                } }
                VCenter { HeaderButton {
                    label: "Clear";
                    preferred-width: 104px;
                    min-width: 104px;
                    tapped => { root.clear(action-row.action.index); }
                } }
            }
            ScrollFade {
                width: midi-list.width;
                offset: -midi-list.viewport-y;
                page: midi-list.height;
                total: midi-list.viewport-height;
            }
            ScrollBar {
                x: midi-list.width - 6px;
                offset: -midi-list.viewport-y;
                page: midi-list.height;
                total: midi-list.viewport-height;
            }
        }
    }
}

component SwitchToggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 56px;
    height: 30px;
    background: root.on ? #1a3af8 : #505050;
    border-radius: 15px;
    Rectangle {
        width: 24px;
        height: 24px;
        x: root.on ? 29px : 3px;
        y: 3px;
        background: #ffffff;
        border-radius: 12px;
        animate x { duration: 120ms; }
    }
    TouchArea { clicked => { root.on = !root.on; root.toggled(root.on); } }
}

component ToolsPanel inherits Rectangle {
    in property <bool> autosave-enabled;
    in property <string> autosave-status;
    callback autosave-toggled(bool);
    in property <string> jack-mode;
    in property <bool> jack-expression;
    in property <string> usb-level;
    in property <float> usb-amount;
    callback usb-set(float);
    in-out property <bool> mute-input;
    in-out property <bool> mute-output;
    callback mute-set(bool, bool);
    in property <string> cab-settings;
    in property <string> expression-summary;
    in property <[ExpressionRangeRow]> expression-ranges;
    in property <[ExpressionBypassRow]> expression-bypasses;
    in property <string> calibration-status;
    in property <string> protocol-status;
    in-out property <bool> tempo-global: true;
    in property <string> meter-input;
    in property <string> meter-output;
    in property <string> meter-expression;
    in property <float> meter-input-amount;
    in property <float> meter-output-amount;
    in property <float> meter-expression-amount;
    callback closed();
    in-out property <int> tab: 0;
    in property <int> section: 0;
    in-out property <int> pedal-tab: 0;
    in-out property <int> midi-tab: 0;
    in property <[BtDevice]> bt-devices;
    callback bt-picked(int);
    callback bt-forget(int);
    in property <int> layout-mode;
    callback layout-tapped(int);
    in property <[MidiRow]> midi-rows;
    in property <string> midi-notice;
    callback midi-learn(int);
    callback midi-clear(int);
    callback clear-requested(int);
    in property <string> clear-status;
    callback usb-storage();
    in property <bool> scene-library-busy;
    in property <bool> save-dirty;
    callback save();
    callback refresh();
    callback tuner();
    callback jack-selected(bool);
    callback calibration-start();
    callback calibration-save();
    callback expression-range-toggle(int);
    callback expression-range-adjust(int, int, int);
    callback expression-bypass-toggle(int);
    callback expression-bypass-adjust(int, int);
    callback expression-save();
    background: Surface.background;
    TouchArea {}
    Rectangle {
        width: root.width;
        height: root.height;
        background: Surface.background;
        TouchArea {}
        VerticalLayout {
            padding: Surface.screen-margin;
            spacing: 7px;
            PopupHeader {
                title: root.section == 1 ? "Pedals" : root.section == 2 ? "MIDI" : "Settings";
                closed => { root.closed(); }
                settings-flick := Flickable {
                    x: parent.tabs-x;
                    width: parent.tabs-width;
                    height: parent.height;
                    viewport-width: max(self.width, settings-tabs.preferred-width);
                    settings-tabs := HorizontalLayout {
                        x: 0px;
                        height: parent.height;
                        width: max(settings-flick.width, self.preferred-width);
                        alignment: end;
                        spacing: 0px;
                        for name[i] in (root.section == 1 ? ["General", "Sweeps", "Bypass", "Calibration"]
                            : root.section == 2 ? ["Controls", "Presets 1-16", "Presets 17-32",
                                "Presets 33-48", "Presets 49-64", "Captures", "Scenes/Gig",
                                "Amp/Cab", "FX switches/models",
                                "Pre FX 1", "Pre FX 2", "Post FX 1", "Post FX 2", "Post FX 3"]
                            : ["General", "Audio", "Bluetooth"]): PopupTab {
                            label: name;
                            active: root.section == 1 ? i == root.pedal-tab
                                : root.section == 2 ? i == root.midi-tab
                                : (i == 0 ? 0 : i == 1 ? 2 : 4) == root.tab;
                            tapped => {
                                if root.section == 1 { root.pedal-tab = i; }
                                else if root.section == 2 { root.midi-tab = i; }
                                else { root.tab = i == 0 ? 0 : i == 1 ? 2 : 4; }
                            }
                        }
                    }
                }
                Rectangle {
                    x: parent.tabs-x;
                    width: 28px;
                    height: parent.height - 4px;
                    visible: settings-flick.viewport-x < -1px;
                    background: @linear-gradient(90deg, #1e1e1e 0%, #1e1e1e00 100%);
                }
                Rectangle {
                    x: parent.tabs-x + parent.tabs-width - 28px;
                    width: 28px;
                    height: parent.height - 4px;
                    visible: settings-flick.viewport-x + settings-flick.width < settings-flick.viewport-width - 1px;
                    background: @linear-gradient(90deg, #1e1e1e00 0%, #1e1e1e 100%);
                }
            }
            Rectangle { height: 2px; }
            if root.section != 2: settings-scroll := Flickable {
                property <int> tab-key: root.section == 1 ? root.pedal-tab : root.tab;
                changed tab-key => { self.viewport-y = 0px; }
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: settings-body.preferred-height;
                settings-body := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: settings-scroll.width - (settings-body.preferred-height > settings-scroll.height ? 16px : 0px);
                    if root.section == 0 && root.tab == 4: BluetoothList {
                        devices: root.bt-devices;
                        picked(index) => { root.bt-picked(index); }
                        forget(index) => { root.bt-forget(index); }
                    }
                    if root.section == 0 && root.tab == 0: VerticalLayout {
                        spacing: 8px;
                        OptionRow {
                            label: "Global tempo";
                            VCenter {
                                Rectangle {
                                    width: 56px;
                                    height: 30px;
                                    background: root.tempo-global ? #1a3af8 : #505050;
                                    border-radius: 15px;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        x: root.tempo-global ? 29px : 3px;
                                        y: 3px;
                                        background: #ffffff;
                                        border-radius: 12px;
                                        animate x { duration: 120ms; }
                                    }
                                    TouchArea { clicked => { root.tempo-global = !root.tempo-global; } }
                                }
                            }
                        }
                        OptionRow {
                            label: "Screen";
                            VCenter { HeaderButton { label: "Land"; choice: true; hot: root.layout-mode == 0; tapped => { root.layout-tapped(0); } } }
                            VCenter { HeaderButton { label: "Land flip"; choice: true; hot: root.layout-mode == 3; tapped => { root.layout-tapped(3); } } }
                            VCenter { HeaderButton { label: "Port"; choice: true; hot: root.layout-mode == 1; tapped => { root.layout-tapped(1); } } }
                            VCenter { HeaderButton { label: "Port flip"; choice: true; hot: root.layout-mode == 2; tapped => { root.layout-tapped(2); } } }
                        }
                        OptionRow {
                            label: "Autosave";
                            VCenter {
                                Rectangle {
                                    width: 56px;
                                    height: 30px;
                                    background: root.autosave-enabled ? #1a3af8 : #505050;
                                    border-radius: 15px;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        x: root.autosave-enabled ? 29px : 3px;
                                        y: 3px;
                                        background: #ffffff;
                                        border-radius: 12px;
                                        animate x { duration: 120ms; }
                                    }
                                    TouchArea { clicked => { root.autosave-toggled(!root.autosave-enabled); } }
                                }
                            }
                        }
                        if root.autosave-status != "": Rectangle {
                            height: 48px;
                            background: transparent;
                            Text {
                                text: root.autosave-status;
                                color: #ececec;
                                font-size: 16px;
                                wrap: word-wrap;
                            }
                        }
                        OptionRow {
                            label: "Configuration";
                            VCenter {
                                HeaderButton {
                                    label: "USB drive";
                                    enabled: !root.scene-library-busy;
                                    tapped => { root.usb-storage(); }
                                }
                            }
                        }
                        OptionRow {
                            label: "Tools";
                            VCenter { horizontal-stretch: 0; HeaderButton { label: "Tuner"; tapped => { root.tuner(); } } }
                            VCenter { horizontal-stretch: 0; HeaderButton { label: "Refresh"; tapped => { root.refresh(); } } }
                            VCenter { horizontal-stretch: 0; HeaderButton { label: "Save"; hot: root.save-dirty; tapped => { root.save(); } } }
                        }
                        OptionRow {
                            label: "Clear";
                            for label[i] in ["MIDI", "Scenes"]: VCenter {
                                width: 96px;
                                horizontal-stretch: 0;
                                HeaderButton {
                                    label: label;
                                    min-width: 0px;
                                    preferred-width: 96px;
                                    enabled: i == 0 || !root.scene-library-busy;
                                    tapped => { root.clear-requested(i + 1); }
                                }
                            }
                        }
                        if root.clear-status != "": Rectangle {
                            height: 48px;
                            background: transparent;
                            Text {
                                text: root.clear-status;
                                color: #ececec;
                                font-size: 16px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    if root.section == 1: VerticalLayout {
                        spacing: 8px;
                        if root.pedal-tab == 0: OptionRow {
                            label: "Jack";
                            value: root.jack-mode;
                            VCenter { HeaderButton {
                                label: root.jack-expression ? "Use MIDI" : "Use EXP";
                                tapped => { root.jack-selected(!root.jack-expression); }
                            } }
                        }
                        if root.pedal-tab == 0: OptionRow {
                            label: "Expression";
                            value: root.expression-summary;
                        }
                        if root.pedal-tab == 1 || root.pedal-tab == 2: OptionRow {
                            label: "Sweep assignments";
                            VCenter {
                                HeaderButton {
                                    label: "Save";
                                    hot: root.expression-summary != "Not loaded";
                                    tapped => { root.expression-save(); }
                                }
                            }
                        }
                        if root.pedal-tab == 1 || root.pedal-tab == 2: Text {
                            text: "Adjust heel/toe in 5% steps. Bypass modes support delay, inversion and switch latch.";
                            color: #909090;
                            font-size: 14px;
                            height: 28px;
                            vertical-alignment: center;
                        }
                        if root.pedal-tab == 1: VerticalLayout {
                            spacing: 8px;
                            for row in root.expression-ranges: OptionRow {
                                label: row.name;
                                value: row.summary;
                                VCenter { HeaderButton {
                                    label: row.enabled ? "On" : "Off";
                                    hot: row.enabled;
                                    tapped => { root.expression-range-toggle(row.target); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: "Min −";
                                    tapped => { root.expression-range-adjust(row.target, 0, -1); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: "Min +";
                                    tapped => { root.expression-range-adjust(row.target, 0, 1); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: "Max −";
                                    tapped => { root.expression-range-adjust(row.target, 1, -1); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: "Max +";
                                    tapped => { root.expression-range-adjust(row.target, 1, 1); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: row.inverted ? "Rev" : "Norm";
                                    choice: true;
                                    hot: row.inverted;
                                    tapped => { root.expression-range-adjust(row.target, 2, 0); }
                                } }
                            }
                        }
                        if root.pedal-tab == 2: VerticalLayout {
                            spacing: 8px;
                            for row in root.expression-bypasses: OptionRow {
                                label: row.name + " switch";
                                value: row.summary;
                                VCenter { HeaderButton {
                                    label: row.enabled ? "On" : "Off";
                                    hot: row.enabled;
                                    tapped => { root.expression-bypass-toggle(row.target); }
                                } }
                                if row.enabled: VCenter { HeaderButton {
                                    label: row.mode == 0 ? "Heel/toe" : (row.mode == 1 ? "Switch" : "Stop");
                                    choice: true;
                                    tapped => { root.expression-bypass-adjust(row.target, 0); }
                                } }
                                if row.enabled && row.mode != 1: VCenter { HeaderButton {
                                    label: "Delay −";
                                    tapped => { root.expression-bypass-adjust(row.target, 1); }
                                } }
                                if row.enabled && row.mode != 1: VCenter { HeaderButton {
                                    label: "Delay +";
                                    tapped => { root.expression-bypass-adjust(row.target, 2); }
                                } }
                                if row.enabled && row.mode != 2: VCenter { HeaderButton {
                                    label: row.inverted ? "Rev" : "Norm";
                                    choice: true;
                                    hot: row.inverted;
                                    tapped => { root.expression-bypass-adjust(row.target, 3); }
                                } }
                                if row.enabled && row.mode == 1: VCenter { HeaderButton {
                                    label: row.latch ? "Latch" : "Momentary";
                                    choice: true;
                                    hot: row.latch;
                                    tapped => { root.expression-bypass-adjust(row.target, 4); }
                                } }
                            }
                        }
                        if root.pedal-tab == 3: OptionRow {
                            label: "Calibration";
                            value: root.calibration-status;
                            VCenter { HeaderButton { label: "Start"; tapped => { root.calibration-start(); } } }
                            VCenter { HeaderButton { label: "Save"; tapped => { root.calibration-save(); } } }
                        }
                        if root.pedal-tab == 3: Text {
                            text: "Start clears the saved range. Sweep heel-to-toe, then save.";
                            color: #909090;
                            font-size: 14px;
                            height: 28px;
                            vertical-alignment: center;
                        }
                    }
                    if root.section == 0 && root.tab == 2: VerticalLayout {
                        spacing: 8px;
                        MeterRow {
                            label-width: 170px;
                            label: "USB level";
                            reading: root.usb-level;
                            amount: root.usb-amount;
                            interactive: true;
                            preview-text(a) => { return round(-40 + a * 40) + " dB"; }
                            released(a) => { root.usb-set(a); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            OptionRow {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                label: "Mute input";
                                VCenter { SwitchToggle { on <=> root.mute-input; toggled(m) => { root.mute-set(true, m); } } }
                            }
                            OptionRow {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                label: "Mute output";
                                VCenter { SwitchToggle { on <=> root.mute-output; toggled(m) => { root.mute-set(false, m); } } }
                            }
                        }
                        MeterRow {
                            label-width: 170px;
                            label: "Capture in";
                            reading: root.meter-input;
                            amount: root.meter-input-amount;
                        }
                        MeterRow {
                            label-width: 170px;
                            label: "Capture out";
                            reading: root.meter-output;
                            amount: root.meter-output-amount;
                        }
                        MeterRow {
                            label-width: 170px;
                            label: "Expression";
                            reading: root.meter-expression;
                            amount: root.meter-expression-amount;
                        }
                    }
                }
                ScrollFade {
                    width: settings-scroll.width;
                    offset: -settings-scroll.viewport-y;
                    page: settings-scroll.height;
                    total: settings-scroll.viewport-height;
                }
                ScrollBar {
                    x: settings-scroll.width - 6px;
                    offset: -settings-scroll.viewport-y;
                    page: settings-scroll.height;
                    total: settings-scroll.viewport-height;
                }
            }
            if root.section == 2: MidiPanel {
                rows: root.midi-rows;
                tab: root.midi-tab;
                notice: root.midi-notice;
                vertical-stretch: 100;
                learn(index) => { root.midi-learn(index); }
                clear(index) => { root.midi-clear(index); }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }

}


// One device's connection state: dot, name and status text.
component StatusLine inherits Rectangle {
    in property <string> label;
    // -1 not seen, 0 nearby, 1 connecting, 2 connected
    in property <int> state;
    height: 28px;
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VCenter {
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: root.state == 2 ? #3dcc7a : (root.state == 1 ? #1a3af8 : (root.state == 0 ? #c8c8c8 : #505050));
            }
        }
        Text {
            text: root.label + ": " + (root.state == 2 ? "Connected" : (root.state == 1 ? "Connecting..." : (root.state == 0 ? "Found, not connected" : "Searching...")));
            color: root.state >= 1 ? #ffffff : #909090;
            font-size: 17px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component ConnectingOverlay inherits Rectangle {
    in property <int> amp-state: -1;
    in property <int> foot-state: -1;
    in property <string> loading: "";
    in property <string> version: "";
    callback scene-library();
    callback usb-storage();
    background: #1e1e1e;
    TouchArea {}
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: Surface.screen-margin;
        // Logo: a knob ring with a pointer dot, echoing the amp's GAIN ring.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: 36px;
                border-width: 6px;
                border-color: #1a3af8;
                Rectangle {
                    width: 50px;
                    height: 50px;
                    border-radius: 25px;
                    background: #2a2a2a;
                    border-width: 2px;
                    border-color: #ffffff;
                }
                Rectangle {
                    y: 11px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #ffffff;
                }
            }
        }
        Text {
            text: "NANO CORTEX";
            color: #ffffff;
            font-size: 30px;
            font-weight: 700;
            letter-spacing: 5px;
            horizontal-alignment: center;
        }
        Text {
            text: "CONTROLLER";
            color: #909090;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 6px;
            horizontal-alignment: center;
        }
        Rectangle { height: 8px; }
        StatusLine { label: "Nano Cortex"; state: root.amp-state; }
        StatusLine { label: "Footswitch"; state: root.foot-state; }
        Text {
            text: root.loading;
            color: #ffffff;
            font-size: 16px;
            font-weight: 700;
            horizontal-alignment: center;
            visible: root.loading != "";
        }
        Rectangle { height: 6px; }
        Text {
            text: "Hold EXIT + CAPTURE on the Nano until the GAIN ring spins.";
            color: #909090;
            font-size: 15px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "Make sure it is not paired with a smartphone or Cortex Cloud.";
            color: #909090;
            font-size: 15px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    HeaderButton {
        x: parent.width - self.width - Surface.screen-margin;
        y: Surface.screen-margin;
        width: 120px;
        height: 40px;
        label: "USB drive";
        tapped => { root.usb-storage(); }
    }
    Text {
        x: Surface.screen-margin;
        y: parent.height - self.height - Surface.screen-margin;
        width: parent.width - 2 * Surface.screen-margin;
        text: root.version == "" ? "" : "v" + root.version;
        color: #707070;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
    }
}

component GigButton inherits Rectangle {
    in property <string> label;
    in property <bool> highlight: false;
    in property <bool> enabled: true;
    callback tapped();
    background: !root.enabled ? #202020 : root.highlight ? #1a3af8 : #303030;
    border-radius: Radius.default;
    Text {
        x: 10px;
        y: 8px;
        width: max(0px, root.width - 20px);
        height: max(0px, root.height - 16px);
        text: root.label;
        color: root.enabled ? #ffffff : #777777;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        overflow: elide;
    }
    TouchArea { enabled: root.enabled; clicked => { root.tapped(); } }
}

component GigPanel inherits Rectangle {
    in property <bool> portrait;
    in property <bool> connected;
    in property <bool> busy;
    in property <string> preset;
    in property <string> notice;
    in property <[string]> scenes;
    in property <[bool]> scene-assigned;
    in property <int> scene: -1;
    callback scene-recall(int);
    callback tuner();
    callback tempo();
    callback editor();
    background: Surface.background;
    TouchArea {}
    VerticalLayout {
        padding: Surface.screen-margin;
        spacing: 8px;
        HorizontalLayout {
            height: 56px;
            spacing: 8px;
            Text { text: "Gig"; font-size: 24px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
            GigButton { width: 88px; label: "Editor"; tapped => { root.editor(); } }
        }
        Text { text: root.preset; min-width: 0px; preferred-width: 0px; font-size: 22px; font-weight: 700; color: #ffffff; overflow: elide; }
        Text { text: root.connected ? root.notice : "Disconnected - connect the Nano to play"; color: #909090; font-size: 14px; wrap: word-wrap; }
        scene-grid := Rectangle {
            min-height: 160px;
            vertical-stretch: 1;
            background: transparent;
            for label[index] in root.scenes: GigButton {
                width: root.portrait ? (scene-grid.width - 8px) / 2 : (scene-grid.width - 24px) / 4;
                height: (scene-grid.height - (ceil(root.scenes.length / (root.portrait ? 2 : 4)) - 1) * 8px) / max(1, ceil(root.scenes.length / (root.portrait ? 2 : 4)));
                x: mod(index, root.portrait ? 2 : 4) * (self.width + 8px);
                y: floor(index / (root.portrait ? 2 : 4)) * (self.height + 8px);
                label: label;
                highlight: root.scene == index;
                enabled: root.connected && !root.busy && root.scene-assigned[index];
                tapped => { root.scene-recall(index); }
            }
        }
        HorizontalLayout {
            height: 60px;
            spacing: 8px;
            GigButton { label: "Tuner"; enabled: root.connected && !root.busy; tapped => { root.tuner(); } }
            GigButton { label: "Tap tempo"; enabled: root.connected && !root.busy; tapped => { root.tempo(); } }
        }
    }
}

component SceneContextMenu inherits Rectangle {
    in property <bool> assigned;
    in property <bool> actions-enabled: true;
    callback chosen(int);
    width: 220px;
    height: 180px;
    background: #303030;
    border-radius: Radius.default;
    for action in 3: Rectangle {
        x: 4px; y: action * 60px;
        width: parent.width - 8px; height: 60px;
        property <bool> action-enabled: root.actions-enabled && (action == 1 || root.assigned);
        Text {
            x: 12px;
            text: action == 0 ? "Rename" : action == 1 ? "Save" : "Delete";
            color: parent.action-enabled ? #f0f0f0 : #666666;
            font-size: 18px; font-weight: 700;
            vertical-alignment: center;
        }
        if action == 2: Rectangle {
            x: 8px;
            y: 0px;
            width: parent.width - 16px;
            height: 1px;
            background: #ffffff30;
        }
        TouchArea {
            enabled: parent.action-enabled;
            clicked => { root.chosen(action); }
        }
    }
}

component ScenePanel inherits Rectangle {
    in-out property <int> menu-index: -1;
    property <length> menu-x;
    property <length> menu-y;
    changed enabled => { root.menu-index = -1; }
    changed portrait => { root.menu-index = -1; }
    changed title => { root.menu-index = -1; }
    in property <bool> portrait;
    property <int> columns: root.portrait ? 2 : 3;
    in property <bool> dirty;
    in property <string> title;
    in property <bool> enabled;
    in property <[bool]> assigned;
    in property <[string]> scenes;
    in property <int> scene: -1;
    callback scene-recall(int);
    callback scene-store(int);
    callback scene-rename(int);
    callback scene-clear(int);
    callback closed();
    background: Surface.background;
    TouchArea {}
    VerticalLayout {
        padding: Surface.screen-margin;
        spacing: 8px;
        PopupHeader {
            title: root.title;
            closed => { root.closed(); }
        }
        Rectangle { height: 2px; }
        scene-list := Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: ceil(root.scenes.length / root.columns) * 102px - 8px;
            for label[index] in root.scenes: Rectangle {
                x: mod(index, root.columns) * (self.width + 8px);
                y: floor(index / root.columns) * 102px;
                width: (scene-list.width - (root.columns - 1) * 8px) / root.columns;
                height: 94px;
                background: index == root.scene ? #1a3af8 : #2a2a2a;
                border-radius: Radius.default;
                TouchArea {
                    x: 0px; y: 0px;
                    width: parent.width - 64px;
                    height: parent.height;
                    enabled: root.enabled && root.assigned[index];
                    clicked => { root.scene-recall(index); }
                }
                Text {
                    x: 10px;
                    width: 32px;
                    text: "0" + (index + 1);
                    color: #ffffff70;
                    font-size: 19px; font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                        Text {
                            x: 48px; y: 8px; height: 78px;
                            width: parent.width - 124px - (index == root.scene && root.dirty ? 16px : 0px);
                            text: label;
                            color: index == root.scene ? #ffffff : #ececec;
                            font-size: 19px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                            wrap: word-wrap;
                        }
                        if index == root.scene && root.dirty: Text {
                            x: parent.width - 92px;
                            width: 16px;
                            text: "*";
                            color: #ffffff;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    Rectangle {
                        x: parent.width - 64px;
                        width: 64px;
                        height: parent.height;
                        VerticalLayout {
                            x: parent.width - 34px;
                            width: 28px;
                            height: parent.height;
                            alignment: center;
                            spacing: 4px;
                            for dot in 3: Rectangle {
                                width: 5px; height: 5px;
                                background: #e0e0e0;
                                border-radius: 3px;
                            }
                        }
                        TouchArea {
                            enabled: root.enabled;
                            clicked => {
                                root.menu-index = index;
                                root.menu-x = clamp(Surface.screen-margin + mod(index, root.columns) * (scene-list.width + 8px) / root.columns
                                    + (scene-list.width - (root.columns - 1) * 8px) / root.columns - 42px,
                                    8px, root.width - 228px);
                                root.menu-y = clamp(90px + floor(index / root.columns) * 102px + scene-list.viewport-y,
                                    8px, root.height - 188px);
                        }
                    }
                }
            }
            ScrollFade { width: scene-list.width; offset: -scene-list.viewport-y; page: scene-list.height; total: scene-list.viewport-height; }
        }
    }
    if root.menu-index >= 0: Rectangle {
        TouchArea { clicked => { root.menu-index = -1; } }
        SceneContextMenu {
            x: root.menu-x; y: root.menu-y;
            assigned: root.assigned[root.menu-index];
            actions-enabled: root.enabled;
            chosen(action) => {
                if action == 0 { root.scene-rename(root.menu-index); }
                else if action == 1 { root.scene-store(root.menu-index); }
                else { root.scene-clear(root.menu-index); }
                root.menu-index = -1;
            }
        }
    }
}

// Centered card over a dimmed backdrop. Outside taps are swallowed, not dismissals.
// The dim is one full-screen blend on open/close; it only covers the static preset list.
component DialogCard inherits Rectangle {
    in property <length> card-width: 440px;
    callback closed();
    background: #000000b0;
    TouchArea {}
    Rectangle {
        width: min(root.card-width, root.width - 24px);
        height: card-content.preferred-height + 36px;
        background: Surface.background;
        border-radius: Radius.default;
        TouchArea {}
        card-content := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            @children
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <color> fill: #2a2a2a;
    in property <bool> enabled: true;
    callback tapped();
    height: 56px;
    background: root.enabled ? root.fill : #202020;
    border-radius: Radius.default;
    Text {
        text: root.label;
        color: root.enabled ? #ffffff : #666666;
        font-size: 19px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { enabled: root.enabled; clicked => { root.tapped(); } }
}

component ConfirmDialog inherits DialogCard {
    in property <string> title;
    in property <string> message;
    in property <string> accept-label: "OK";
    in property <color> accept-fill: #1a3af8;
    callback accepted();
    Text {
        text: root.title;
        color: #e0e0e0;
        font-size: 22px;
        font-weight: 700;
    }
    Text {
        text: root.message;
        color: #c8c8c8;
        font-size: 17px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        DialogButton { label: "Cancel"; fill: #000000; tapped => { root.closed(); } }
        DialogButton { label: root.accept-label; fill: root.accept-fill; tapped => { root.accepted(); } }
    }
}

component KeyCap inherits Rectangle {
    in property <string> label;
    in property <bool> hot: false;
    in property <length> key-height: 56px;
    // Held keys repeat like a PC keyboard: one tap, a pause, then a steady stream.
    in property <bool> repeat: false;
    property <bool> repeated: false;
    callback tapped();
    height: root.key-height;
    horizontal-stretch: 1;
    background: touch.pressed ? (root.hot ? #5a78ff : #5c5c5c) : (root.hot ? #1a3af8 : #2a2a2a);
    border-radius: 8px;
    Text {
        text: root.label;
        color: #ffffff;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        changed pressed => {
            if self.pressed { root.repeated = false; }
        }
        clicked => {
            if !root.repeated { root.tapped(); }
        }
    }
    Timer {
        interval: root.repeated ? 60ms : 400ms;
        running: root.repeat && touch.pressed;
        triggered => {
            root.repeated = true;
            root.tapped();
        }
    }
}

// Typing goes through `key` ("\u{8}" is backspace) so Rust owns the text and its limits.
component NameKeyboard inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> error;
    callback key(string);
    callback accepted();
    callback closed();
    property <bool> shift: true;
    property <bool> cursor-visible: true;
    Timer {
        interval: 500ms;
        running: true;
        triggered => { root.cursor-visible = !root.cursor-visible; }
    }
    changed text => { root.cursor-visible = true; }
    // Square keys, capped so five rows fit below the header and error line.
    property <length> key-width: (root.width - 2 * Surface.screen-margin - 54px) / 10;
    property <length> key-height: min(root.key-width, (root.height - 2 * Surface.screen-margin - 136px) / 5);
    background: Surface.background;
    TouchArea {}
    Rectangle {
        width: root.width;
        height: root.height;
        background: Surface.background;
        TouchArea {}
        VerticalLayout {
            padding: Surface.screen-margin;
            spacing: 8px;
            PopupHeader {
                title: "";
                closed => { root.closed(); }
                Rectangle {
                    x: 54px;
                    y: 3px;
                    width: parent.width - 54px;
                    height: 42px;
                    background: #101010;
                    border-radius: Radius.default;
                    // Long names keep their end visible; the start scrolls off to the left.
                    Rectangle {
                        x: 14px;
                        width: parent.width - 38px;
                        clip: true;
                        name-text := Text {
                            x: min(0px, parent.width - self.preferred-width);
                            width: self.preferred-width;
                            text: root.text;
                            color: #e0e0e0;
                            font-size: 26px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 14px + min(name-text.preferred-width, parent.width - 38px);
                        width: 10px;
                        text: "|";
                        color: #e0e0e0;
                        font-size: 26px;
                        font-weight: 700;
                        vertical-alignment: center;
                        visible: root.cursor-visible;
                    }
                }
            }
            Text {
                height: 22px;
                text: root.error;
                color: #ff8a80;
                font-size: 15px;
            }
            // Header stays on top like the other popups; keys sit at the bottom.
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                for k in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]: KeyCap { label: k; key-height: root.key-height; tapped => { root.key(k); } }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                for k in ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"]: KeyCap {
                    label: root.shift ? k.to-uppercase() : k;
                    key-height: root.key-height;
                    tapped => { root.key(root.shift ? k.to-uppercase() : k); root.shift = false; }
                }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                Rectangle { horizontal-stretch: 0.5; }
                for k in ["a", "s", "d", "f", "g", "h", "j", "k", "l"]: KeyCap {
                    label: root.shift ? k.to-uppercase() : k;
                    key-height: root.key-height;
                    tapped => { root.key(root.shift ? k.to-uppercase() : k); root.shift = false; }
                }
                Rectangle { horizontal-stretch: 0.5; }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                KeyCap { label: "Aa"; hot: root.shift; key-height: root.key-height; horizontal-stretch: 1.5; tapped => { root.shift = !root.shift; } }
                for k in ["z", "x", "c", "v", "b", "n", "m"]: KeyCap {
                    label: root.shift ? k.to-uppercase() : k;
                    key-height: root.key-height;
                    tapped => { root.key(root.shift ? k.to-uppercase() : k); root.shift = false; }
                }
                KeyCap { label: "<-"; repeat: true; key-height: root.key-height; horizontal-stretch: 1.5; tapped => { root.key("\u{8}"); } }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                KeyCap { label: "-"; key-height: root.key-height; tapped => { root.key("-"); } }
                KeyCap { label: "_"; key-height: root.key-height; tapped => { root.key("_"); } }
                KeyCap { label: "Space"; key-height: root.key-height; horizontal-stretch: 4; tapped => { root.key(" "); } }
                KeyCap { label: "Done"; hot: root.error == ""; key-height: root.key-height; horizontal-stretch: 2; tapped => { if (root.error == "") { root.accepted(); } } }
            }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <bool> connecting: true;
    in-out property <bool> portrait: false;
    in-out property <int> layout-mode: 0;
    in-out property <int> page: 0;
    in-out property <int> chain: 2;
    in-out property <string> preset: "-";
    in-out property <string> model: "Amp";
    in-out property <bool> model-enabled: false;
    in-out property <string> capture-title: "CAPTURE";
    in-out property <string> capture-value: "-";
    in-out property <string> capture-slot: "-";
    in-out property <bool> capture-active: false;
    in-out property <string> cab-value: "-";
    in-out property <string> cab-slot: "-";
    in-out property <bool> cab-active: false;
    in-out property <string> bpm-text: "- BPM";
    // True while Tempo Mode is open (taps recently sent); the readout turns green.
    in-out property <int> tempo-bpm-value: 0;
    in-out property <bool> tempo-active: false;
    // Tempo is shared across presets; shows the globe next to the BPM.
    in-out property <bool> tempo-global: true;
    in-out property <string> tuner-note: "-";
    in-out property <string> tuner-cents: "Tuner off";
    in-out property <string> tuner-reference: "440 Hz";
    in-out property <float> tuner-reference-hz: 440;
    in-out property <float> tuner-pos: 0.5;
    in-out property <bool> tuner-has-pitch: false;
    in-out property <bool> tuner-in-tune: false;
    in-out property <bool> tuner-muted: false;
    in-out property <bool> save-dirty: false;
    in-out property <bool> autosave-enabled: false;
    in-out property <string> autosave-status: "";
    callback autosave-toggled(bool);
    in-out property <bool> ble-on: false;
    in-out property <bool> bt-busy: false;
    in-out property <int> settings-tab: 0;
    // Settings, Pedals and MIDI share the tools data and full-screen shell.
    in-out property <int> tools-section: 0;
    in-out property <int> pedal-tab: 0;
    in-out property <int> midi-tab: 0;
    in-out property <bool> header-menu-open: false;
    // Firmware polls this to refresh the device rows only while they are visible.
    in-out property <bool> bt-open: root.settings-open && root.tools-section == 0 && root.settings-tab == 4;
    in-out property <bool> settings-open: false;
    in-out property <bool> model-open: false;
    in-out property <int> list-kind: 0;
    in-out property <int> preset-menu-index: -1;
    in-out property <string> model-list-title: "";
    in-out property <[ModelItem]> model-list: [];
    in-out property <float> model-list-height: 0;
    in-out property <int> model-list-current: -1;
    in-out property <int> model-list-section: 0;
    in-out property <bool> kbd-open: false;
    in-out property <string> kbd-title: "";
    in-out property <string> kbd-text: "";
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-title: "";
    in-out property <string> confirm-message: "";
    in-out property <string> confirm-label: "OK";
    in-out property <bool> confirm-danger: false;
    in-out property <[BtDevice]> bt-devices;
    in-out property <int> conn-amp: -1;
    in-out property <string> load-status: "";
    in-out property <string> app-version: "";
    in-out property <int> conn-foot: -1;
    in-out property <string> gate-text: "-";
    in-out property <float> gate-amount: 0;
    in-out property <string> gate-amnt-text: "-";
    in-out property <float> gate-amnt-amount: 0;
    in-out property <string> gain-text: "-";
    in-out property <float> gain-amount: 0;
    in-out property <string> cap-text: "-";
    in-out property <float> cap-amount: 0;
    in-out property <string> master-text: "-";
    in-out property <float> master-amount: 0;
    in-out property <string> bass-text: "-";
    in-out property <float> bass-amount: 0;
    in-out property <string> mid-text: "-";
    in-out property <float> mid-amount: 0;
    in-out property <string> treble-text: "-";
    in-out property <float> treble-amount: 0;
    in-out property <string> cab-output-text: "-- dB";
    in-out property <float> cab-output-amount: 0;
    in-out property <string> cab-high-pass-text: "-- Hz";
    in-out property <float> cab-high-pass-amount: 0;
    in-out property <string> cab-low-pass-text: "-- Hz";
    in-out property <float> cab-low-pass-amount: 0;
    in-out property <string> fx-n0: "-";
    in-out property <string> fx-v0: "-";
    in-out property <float> fx-a0: 0;
    in-out property <string> fx-n1: "-";
    in-out property <string> fx-v1: "-";
    in-out property <float> fx-a1: 0;
    in-out property <string> fx-n2: "-";
    in-out property <string> fx-v2: "-";
    in-out property <float> fx-a2: 0;
    in-out property <string> fx-n3: "-";
    in-out property <string> fx-v3: "-";
    in-out property <float> fx-a3: 0;
    in-out property <string> fx-n4: "-";
    in-out property <string> fx-v4: "-";
    in-out property <float> fx-a4: 0;
    in-out property <string> fx-n5: "-";
    in-out property <string> fx-v5: "-";
    in-out property <float> fx-a5: 0;
    in-out property <string> fx-n6: "-";
    in-out property <string> fx-v6: "-";
    in-out property <float> fx-a6: 0;
    in-out property <string> fx-n7: "-";
    in-out property <string> fx-v7: "-";
    in-out property <float> fx-a7: 0;
    in-out property <string> fx-n8: "-";
    in-out property <string> fx-v8: "-";
    in-out property <float> fx-a8: 0;
    in-out property <string> fx-n9: "-";
    in-out property <string> fx-v9: "-";
    in-out property <float> fx-a9: 0;
    in-out property <string> fx-n10: "-";
    in-out property <string> fx-v10: "-";
    in-out property <float> fx-a10: 0;
    in-out property <string> fx-n11: "-";
    in-out property <string> fx-v11: "-";
    in-out property <float> fx-a11: 0;
    in-out property <string> fx-n12: "-";
    in-out property <string> fx-v12: "-";
    in-out property <float> fx-a12: 0;
    in-out property <string> fx-n13: "-";
    in-out property <string> fx-v13: "-";
    in-out property <float> fx-a13: 0;
    in-out property <string> fx-n14: "-";
    in-out property <string> fx-v14: "-";
    in-out property <float> fx-a14: 0;
    in-out property <string> fx-n15: "-";
    in-out property <string> fx-v15: "-";
    in-out property <float> fx-a15: 0;
    in-out property <string> fx-n16: "-";
    in-out property <string> fx-v16: "-";
    in-out property <float> fx-a16: 0;
    in-out property <string> fx-n17: "-";
    in-out property <string> fx-v17: "-";
    in-out property <float> fx-a17: 0;
    in-out property <string> fx-n18: "-";
    in-out property <string> fx-v18: "-";
    in-out property <float> fx-a18: 0;
    in-out property <string> fx-n19: "-";
    in-out property <string> fx-v19: "-";
    in-out property <float> fx-a19: 0;
    in-out property <string> fx-n20: "-";
    in-out property <string> fx-v20: "-";
    in-out property <float> fx-a20: 0;
    in-out property <string> fx-n21: "-";
    in-out property <string> fx-v21: "-";
    in-out property <float> fx-a21: 0;
    in-out property <string> fx-n22: "-";
    in-out property <string> fx-v22: "-";
    in-out property <float> fx-a22: 0;
    in-out property <string> fx-n23: "-";
    in-out property <string> fx-v23: "-";
    in-out property <float> fx-a23: 0;
    in-out property <string> tab-0: "FX";
    in-out property <int> category-0: 0;
    in-out property <int> category-1: 0;
    in-out property <int> category-3: 0;
    in-out property <int> category-4: 0;
    in-out property <int> category-5: 0;
    in-out property <string> tab-1: "FX";
    in-out property <string> tab-3: "FX";
    in-out property <string> tab-4: "FX";
    in-out property <string> tab-5: "FX";
    in-out property <bool> on-0: false;
    in-out property <bool> on-1: false;
    in-out property <bool> on-3: false;
    in-out property <bool> on-4: false;
    in-out property <bool> on-5: false;
    in-out property <bool> tuner-active: false;
    in-out property <string> tools-jack-mode: "Unknown";
    in-out property <bool> tools-jack-expression: false;
    in-out property <string> tools-usb-level: "-";
    in-out property <string> tools-cab-settings: "Not loaded";
    in-out property <string> tools-expression-summary: "Not loaded";
    in-out property <string> tools-calibration-status: "Idle";
    in-out property <string> tools-protocol-status: "";
    in-out property <string> tools-meter-input: "-";
    in-out property <string> tools-meter-output: "-";
    in-out property <string> tools-meter-expression: "-";
    in-out property <float> tools-meter-input-amount: 0;
    in-out property <float> tools-meter-output-amount: 0;
    in-out property <float> tools-meter-expression-amount: 0;

    callback chain-tapped(int);
    callback chain-held(int);
    callback chain-double(int);
    callback tuner-tapped();
    callback tuner-reference-set(int);
    callback tuner-mute-tapped();
    callback tempo-tapped();
    callback layout-tapped(int);
    callback slider-moved(int, float);
    callback cab-slider-moved(int, float);
    callback gate-tapped();
    callback param-changed(int, float);
    callback preset-list-tapped();
    callback capture-stepped(int);
    callback model-stepped(int);
    callback save-tapped();
    callback copy-tapped();
    callback library-tapped();
    callback bt-picked(int);
    callback bt-forget(int);
    callback model-list-tapped();
    callback capture-list-tapped();
    callback cab-list-tapped();
    callback model-chosen(int);
    callback model-preset-action-chosen(int, int);
    callback kbd-key(string);
    callback kbd-accepted();
    callback confirm-accepted();
    in-out property <string> kbd-error;
    callback tools-opened();
    callback tools-refresh();
    in-out property <[MidiRow]> midi-rows: [];
    in-out property <string> midi-last: "";
    in-out property <string> midi-notice: "";
    callback midi-closed();
    changed settings-open => {
        if !self.settings-open { root.midi-closed(); }
    }
    changed midi-tab => { root.midi-closed(); }
    changed tools-section => { root.midi-closed(); }
    callback midi-learn(int);
    callback midi-clear(int);
    callback midi-clear-all();
    callback midi-clear-all-requested();
    callback usb-storage-requested();
    callback usb-storage-cancel();
    callback usb-storage-restart();
    in-out property <bool> usb-storage-open: false;
    in-out property <bool> usb-storage-finished: false;
    in-out property <string> usb-storage-message: "";
    callback scene-library-clear-all(int);
    callback clear-requested(int);
    in-out property <int> clear-status-kind: 0;
    in-out property <string> clear-status: "";
    property <int> clear-confirm-kind: 0;
    callback scene-library-opened();
    callback header-scene-action(int);
    property <bool> header-scene-menu-open: false;
    changed scene-label => { root.header-scene-menu-open = false; }
    changed scene-library-busy => { root.header-scene-menu-open = false; }
    in-out property <bool> scene-library-open: false;
    in-out property <string> scene-library-notice: "";
    in-out property <int> scene-library-name-action: 0;
    in-out property <int> scene-library-edit-scene: -1;
    in-out property <int> scene-library-scene: -1;
    in-out property <string> scene-label: "Scene";
    in-out property <int> scene-preset: 1;
    in-out property <string> scene-title: "";
    in-out property <int> scene-menu-index: -1;
    changed scene-library-open => { root.scene-menu-index = -1; }
    changed kbd-open => { root.scene-menu-index = -1; }
    in-out property <bool> scene-dirty: false;
    in-out property <[bool]> scene-assigned: [];
    in-out property <[string]> scene-library-scenes: [];
    in-out property <bool> gig-open: false;
    in-out property <bool> scene-library-busy: false;
    in-out property <[string]> gig-scenes: [];
    in-out property <[bool]> gig-scene-assigned: [];
    in-out property <int> gig-scene: -1;
    callback gig-scene-recall(int);
    callback gig-mode-set(bool);
    gig-mode-set(enabled) => {
        root.gig-open = enabled;
        root.settings-open = false;
        root.scene-library-open = false;
        root.model-open = false;
        root.confirm-open = false;
        root.kbd-open = false;
        root.scene-library-name-action = 0;
        root.midi-clear-confirm = false;
        root.clear-confirm-kind = 0;
    }
    callback scene-library-scene-recall(int);
    callback scene-library-scene-store(int);
    callback scene-library-scene-rename(int);
    callback scene-library-scene-clear(int);
    property <bool> midi-clear-confirm: false;
    midi-clear-all-requested => {
        root.clear-confirm-kind = 0;
        root.confirm-title = "Clear all MIDI bindings?";
        root.confirm-message = "All learned MIDI assignments will be removed. Nano presets and settings are unchanged.";
        root.confirm-label = "Clear all";
        root.confirm-danger = true;
        root.midi-clear-confirm = true;
        root.confirm-open = true;
    }
    clear-requested(kind) => {
        if kind == 1 {
            root.midi-clear-all-requested();
        } else {
            root.midi-clear-confirm = false;
            root.clear-confirm-kind = kind;
            root.confirm-title = "Clear all scenes?";
            root.confirm-message = "All controller scenes across all Nano presets will be removed. The current Nano sound is unchanged.";
            root.confirm-label = "Clear all";
            root.confirm-danger = true;
            root.confirm-open = true;
        }
    }
    callback tools-jack-selected(bool);
    in-out property <float> tools-usb-amount: 0;
    callback tools-usb-set(float);
    in-out property <bool> tools-mute-input: false;
    in-out property <bool> tools-mute-output: false;
    callback tools-mute-set(bool, bool);
    callback tools-calibration-start();
    callback tools-calibration-save();
    in-out property <[ExpressionRangeRow]> tools-expression-ranges: [];
    in-out property <[ExpressionBypassRow]> tools-expression-bypasses: [];
    callback tools-expression-range-toggle(int);
    callback tools-expression-range-adjust(int, int, int);
    callback tools-expression-bypass-toggle(int);
    callback tools-expression-bypass-adjust(int, int);
    callback tools-expression-save();

    // 4.3B panel size; the firmware overrides it with set_size().
    preferred-width: 800px;
    preferred-height: 480px;
    background: Surface.background;
    default-font-family: "IBM Plex Sans";
    default-font-size: 17px;
    // The software renderer draws everything under an overlay, so hide what an
    // opaque or full-screen layer covers.
    // Confirmations are cards over whatever is open, so they do not hide it.
    property <bool> popup-open: root.kbd-open || root.model-open || root.settings-open || root.usb-storage-open || root.scene-library-open || (root.gig-open && root.page != 2);
    property <bool> main-covered: root.popup-open || root.connecting;
    changed main-covered => { root.header-menu-open = false; root.header-scene-menu-open = false; }
    changed portrait => { root.header-menu-open = false; root.header-scene-menu-open = false; }

    Rectangle {
        visible: !root.main-covered;
        VerticalLayout {
            padding: Surface.screen-margin;
            HeaderBar {
                height: 48px;
                portrait: root.portrait;
                page: root.page;
                preset: root.preset;
                model-enabled: root.model-enabled;
                bpm-text: root.bpm-text;
                save-dirty: root.save-dirty;
                tempo-active: root.tempo-active;
                tempo-global: root.tempo-global;
                bpm-value: root.tempo-bpm-value;
                tempo-tapped => { root.tempo-tapped(); }
                preset-list-tapped => { root.preset-list-tapped(); }
                settings-tapped => {
                    root.header-scene-menu-open = false;
                    root.header-menu-open = !root.header-menu-open;
                }
                scene-library-tapped => { root.scene-library-opened(); }
                scene-held => {
                    if root.gig-scene >= 0 {
                        root.header-menu-open = false;
                        root.header-scene-menu-open = true;
                    }
                }
                scene-label: root.scene-label;
                scene-enabled: !root.connecting && !root.scene-library-busy;
            }
            if root.page != 2: Rectangle { height: 8px; }
            if root.page != 2 && !root.portrait: HorizontalLayout {
                // With the panels' 2px inset this is the 8px gap used between chain tabs.
                spacing: 6px;
                ChainRail {
                    width: 108px;
                    page: root.page;
                    chain: root.chain;
                    tab-0: root.tab-0;
                    category-0: root.category-0;
                    category-1: root.category-1;
                    category-3: root.category-3;
                    category-4: root.category-4;
                    category-5: root.category-5;
                    on-0: root.on-0;
                    tab-1: root.tab-1;
                    on-1: root.on-1;
                    tab-3: root.tab-3;
                    on-3: root.on-3;
                    tab-4: root.tab-4;
                    on-4: root.on-4;
                    tab-5: root.tab-5;
                    on-5: root.on-5;
                    chain-tapped(index) => { root.chain-tapped(index); }
                    chain-held(index) => { root.chain-held(index); }
                    chain-double(index) => { root.chain-double(index); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                    clip: true;
                    if root.page == 0: AmpPanel {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        capture-tapped => { root.capture-list-tapped(); }
                        cab-tapped => { root.cab-list-tapped(); }
                        portrait: root.portrait;
                        capture-title: root.capture-title;
                        capture-value: root.capture-value;
                        capture-slot: root.capture-slot;
                        capture-active: root.capture-active;
                        cab-value: root.cab-value;
                        cab-slot: root.cab-slot;
                        cab-active: root.cab-active;
                        gate-text: root.gate-text;
                        gate-amount: root.gate-amount;
                        gate-amnt-text: root.gate-amnt-text;
                        gate-amnt-amount: root.gate-amnt-amount;
                        gain-text: root.gain-text;
                        gain-amount: root.gain-amount;
                        cap-text: root.cap-text;
                        cap-amount: root.cap-amount;
                        master-text: root.master-text;
                        master-amount: root.master-amount;
                        bass-text: root.bass-text;
                        bass-amount: root.bass-amount;
                        mid-text: root.mid-text;
                        mid-amount: root.mid-amount;
                        treble-text: root.treble-text;
                        treble-amount: root.treble-amount;
                        cab-output-text: root.cab-output-text;
                        cab-output-amount: root.cab-output-amount;
                        cab-high-pass-text: root.cab-high-pass-text;
                        cab-high-pass-amount: root.cab-high-pass-amount;
                        cab-low-pass-text: root.cab-low-pass-text;
                        cab-low-pass-amount: root.cab-low-pass-amount;
                        slider-moved(id, amount) => { root.slider-moved(id, amount); }
                        cab-slider-moved(id, amount) => { root.cab-slider-moved(id, amount); }
                        gate-tapped => { root.gate-tapped(); }
                    }
                    if root.page == 1: FxPanel {
                        model-name: root.model;
                        model-enabled: root.model-enabled;
                        model-list-tapped => { root.model-list-tapped(); }
                        model-stepped(delta) => { root.model-stepped(delta); }
                        n0: root.fx-n0; v0: root.fx-v0; a0: root.fx-a0;
                        n1: root.fx-n1; v1: root.fx-v1; a1: root.fx-a1;
                        n2: root.fx-n2; v2: root.fx-v2; a2: root.fx-a2;
                        n3: root.fx-n3; v3: root.fx-v3; a3: root.fx-a3;
                        n4: root.fx-n4; v4: root.fx-v4; a4: root.fx-a4;
                        n5: root.fx-n5; v5: root.fx-v5; a5: root.fx-a5;
                        n6: root.fx-n6; v6: root.fx-v6; a6: root.fx-a6;
                        n7: root.fx-n7; v7: root.fx-v7; a7: root.fx-a7;
                        n8: root.fx-n8; v8: root.fx-v8; a8: root.fx-a8;
                        n9: root.fx-n9; v9: root.fx-v9; a9: root.fx-a9;
                        n10: root.fx-n10; v10: root.fx-v10; a10: root.fx-a10;
                        n11: root.fx-n11; v11: root.fx-v11; a11: root.fx-a11;
                        n12: root.fx-n12; v12: root.fx-v12; a12: root.fx-a12;
                        n13: root.fx-n13; v13: root.fx-v13; a13: root.fx-a13;
                        n14: root.fx-n14; v14: root.fx-v14; a14: root.fx-a14;
                        n15: root.fx-n15; v15: root.fx-v15; a15: root.fx-a15;
                        n16: root.fx-n16; v16: root.fx-v16; a16: root.fx-a16;
                        n17: root.fx-n17; v17: root.fx-v17; a17: root.fx-a17;
                        n18: root.fx-n18; v18: root.fx-v18; a18: root.fx-a18;
                        n19: root.fx-n19; v19: root.fx-v19; a19: root.fx-a19;
                        n20: root.fx-n20; v20: root.fx-v20; a20: root.fx-a20;
                        n21: root.fx-n21; v21: root.fx-v21; a21: root.fx-a21;
                        n22: root.fx-n22; v22: root.fx-v22; a22: root.fx-a22;
                        n23: root.fx-n23; v23: root.fx-v23; a23: root.fx-a23;
                        param-changed(cell, amount) => { root.param-changed(cell, amount); }
                    }
                }
            }
            // Portrait keeps the chain at the bottom, under the page content.
            if root.page != 2 && root.portrait: VerticalLayout {
                spacing: 8px;
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    clip: true;
                    if root.page == 0: AmpPanel {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        capture-tapped => { root.capture-list-tapped(); }
                        cab-tapped => { root.cab-list-tapped(); }
                        portrait: root.portrait;
                        capture-title: root.capture-title;
                        capture-value: root.capture-value;
                        capture-slot: root.capture-slot;
                        capture-active: root.capture-active;
                        cab-value: root.cab-value;
                        cab-slot: root.cab-slot;
                        cab-active: root.cab-active;
                        gate-text: root.gate-text;
                        gate-amount: root.gate-amount;
                        gate-amnt-text: root.gate-amnt-text;
                        gate-amnt-amount: root.gate-amnt-amount;
                        gain-text: root.gain-text;
                        gain-amount: root.gain-amount;
                        cap-text: root.cap-text;
                        cap-amount: root.cap-amount;
                        master-text: root.master-text;
                        master-amount: root.master-amount;
                        bass-text: root.bass-text;
                        bass-amount: root.bass-amount;
                        mid-text: root.mid-text;
                        mid-amount: root.mid-amount;
                        treble-text: root.treble-text;
                        treble-amount: root.treble-amount;
                        cab-output-text: root.cab-output-text;
                        cab-output-amount: root.cab-output-amount;
                        cab-high-pass-text: root.cab-high-pass-text;
                        cab-high-pass-amount: root.cab-high-pass-amount;
                        cab-low-pass-text: root.cab-low-pass-text;
                        cab-low-pass-amount: root.cab-low-pass-amount;
                        slider-moved(id, amount) => { root.slider-moved(id, amount); }
                        cab-slider-moved(id, amount) => { root.cab-slider-moved(id, amount); }
                        gate-tapped => { root.gate-tapped(); }
                    }
                    if root.page == 1: FxPanel {
                        model-name: root.model;
                        model-enabled: root.model-enabled;
                        model-list-tapped => { root.model-list-tapped(); }
                        model-stepped(delta) => { root.model-stepped(delta); }
                        n0: root.fx-n0; v0: root.fx-v0; a0: root.fx-a0;
                        n1: root.fx-n1; v1: root.fx-v1; a1: root.fx-a1;
                        n2: root.fx-n2; v2: root.fx-v2; a2: root.fx-a2;
                        n3: root.fx-n3; v3: root.fx-v3; a3: root.fx-a3;
                        n4: root.fx-n4; v4: root.fx-v4; a4: root.fx-a4;
                        n5: root.fx-n5; v5: root.fx-v5; a5: root.fx-a5;
                        n6: root.fx-n6; v6: root.fx-v6; a6: root.fx-a6;
                        n7: root.fx-n7; v7: root.fx-v7; a7: root.fx-a7;
                        n8: root.fx-n8; v8: root.fx-v8; a8: root.fx-a8;
                        n9: root.fx-n9; v9: root.fx-v9; a9: root.fx-a9;
                        n10: root.fx-n10; v10: root.fx-v10; a10: root.fx-a10;
                        n11: root.fx-n11; v11: root.fx-v11; a11: root.fx-a11;
                        n12: root.fx-n12; v12: root.fx-v12; a12: root.fx-a12;
                        n13: root.fx-n13; v13: root.fx-v13; a13: root.fx-a13;
                        n14: root.fx-n14; v14: root.fx-v14; a14: root.fx-a14;
                        n15: root.fx-n15; v15: root.fx-v15; a15: root.fx-a15;
                        n16: root.fx-n16; v16: root.fx-v16; a16: root.fx-a16;
                        n17: root.fx-n17; v17: root.fx-v17; a17: root.fx-a17;
                        n18: root.fx-n18; v18: root.fx-v18; a18: root.fx-a18;
                        n19: root.fx-n19; v19: root.fx-v19; a19: root.fx-a19;
                        n20: root.fx-n20; v20: root.fx-v20; a20: root.fx-a20;
                        n21: root.fx-n21; v21: root.fx-v21; a21: root.fx-a21;
                        n22: root.fx-n22; v22: root.fx-v22; a22: root.fx-a22;
                        n23: root.fx-n23; v23: root.fx-v23; a23: root.fx-a23;
                        param-changed(cell, amount) => { root.param-changed(cell, amount); }
                    }
                }
                ChainRail {
                    height: 52px;
                    horizontal: true;
                    page: root.page;
                    chain: root.chain;
                    tab-0: root.tab-0;
                    category-0: root.category-0;
                    category-1: root.category-1;
                    category-3: root.category-3;
                    category-4: root.category-4;
                    category-5: root.category-5;
                    on-0: root.on-0;
                    tab-1: root.tab-1;
                    on-1: root.on-1;
                    tab-3: root.tab-3;
                    on-3: root.on-3;
                    tab-4: root.tab-4;
                    on-4: root.on-4;
                    tab-5: root.tab-5;
                    on-5: root.on-5;
                    chain-tapped(index) => { root.chain-tapped(index); }
                    chain-held(index) => { root.chain-held(index); }
                    chain-double(index) => { root.chain-double(index); }
                }
            }
            if root.page == 2: TunerPanel {
                vertical-stretch: 1;
                note: root.tuner-note;
                cents: root.tuner-cents;
                reference: root.tuner-reference;
                cents-pos: root.tuner-pos;
                has-pitch: root.tuner-has-pitch;
                in-tune: root.tuner-in-tune;
                active: root.tuner-active;
                muted: root.tuner-muted;
                tuner-tapped => { root.tuner-tapped(); }
                reference-hz: root.tuner-reference-hz;
                reference-set(hz) => { root.tuner-reference-set(hz); }
                mute-tapped => { root.tuner-mute-tapped(); }
            }
        }
    }

    if root.header-scene-menu-open && !root.main-covered: Rectangle {
        width: root.width;
        height: root.height;
        TouchArea { clicked => { root.header-scene-menu-open = false; } }
        SceneContextMenu {
            x: parent.width - self.width - Surface.screen-margin - 44px;
            y: Surface.screen-margin + 52px;
            assigned: root.gig-scene >= 0;
            actions-enabled: !root.connecting && !root.scene-library-busy;
            chosen(action) => {
                root.header-scene-menu-open = false;
                root.header-scene-action(action);
            }
        }
    }

    if root.header-menu-open && !root.main-covered: Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;
        TouchArea { clicked => { root.header-menu-open = false; } }
        Rectangle {
            x: parent.width - self.width - Surface.screen-margin;
            y: Surface.screen-margin + 52px;
            width: 220px;
            height: 240px;
            background: #303030;
            border-radius: Radius.default;
            for name[i] in ["Gig mode", "MIDI", "Pedals", "Settings"]: Rectangle {
                x: 4px;
                y: i * 59px;
                width: parent.width - 8px;
                height: 58px;
                background: transparent;
                if i == 1: Rectangle {
                    x: 8px;
                    y: 0px;
                    width: parent.width - 16px;
                    height: 1px;
                    background: #ffffff30;
                }
                Text {
                    x: 12px;
                    text: name;
                    color: #f0f0f0;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        root.header-menu-open = false;
                        if i == 0 {
                            if root.page == 2 { root.tuner-tapped(); }
                            root.gig-mode-set(true);
                        } else {
                            root.gig-open = false;
                            root.tools-section = i == 1 ? 2 : i == 2 ? 1 : 0;
                            root.settings-tab = 0;
                            root.pedal-tab = 0;
                            root.midi-tab = 0;
                            root.tools-opened();
                        }
                    }
                }
            }
        }
    }

    if root.settings-open: ToolsPanel {
        autosave-enabled: root.autosave-enabled;
        autosave-status: root.autosave-status;
        autosave-toggled(enabled) => { root.autosave-toggled(enabled); }
        visible: !root.kbd-open;
        jack-mode: root.tools-jack-mode;
        jack-expression: root.tools-jack-expression;
        usb-level: root.tools-usb-level;
        usb-amount: root.tools-usb-amount;
        usb-set(amount) => { root.tools-usb-set(amount); }
        mute-input <=> root.tools-mute-input;
        mute-output <=> root.tools-mute-output;
        mute-set(input, muted) => { root.tools-mute-set(input, muted); }
        cab-settings: root.tools-cab-settings;
        expression-summary: root.tools-expression-summary;
        expression-ranges: root.tools-expression-ranges;
        expression-bypasses: root.tools-expression-bypasses;
        calibration-status: root.tools-calibration-status;
        protocol-status: root.tools-protocol-status;
        meter-input: root.tools-meter-input;
        meter-output: root.tools-meter-output;
        meter-expression: root.tools-meter-expression;
        meter-input-amount: root.tools-meter-input-amount;
        meter-output-amount: root.tools-meter-output-amount;
        meter-expression-amount: root.tools-meter-expression-amount;
        midi-rows: root.midi-rows;
        midi-notice: root.midi-notice;
        midi-learn(index) => { root.midi-learn(index); }
        midi-clear(index) => { root.midi-clear(index); }
        clear-requested(kind) => { root.clear-requested(kind); }
        usb-storage => { root.usb-storage-requested(); }
        clear-status: root.clear-status;
        scene-library-busy: root.scene-library-busy;
        tuner => { root.settings-open = false; root.tuner-tapped(); }
        save-dirty: root.save-dirty;
        save => { root.save-tapped(); }
        refresh => { root.tools-refresh(); }
        jack-selected(expression) => { root.tools-jack-selected(expression); }
        calibration-start => { root.tools-calibration-start(); }
        calibration-save => { root.tools-calibration-save(); }
        expression-range-toggle(target) => { root.tools-expression-range-toggle(target); }
        expression-range-adjust(target, field, delta) => {
            root.tools-expression-range-adjust(target, field, delta);
        }
        expression-bypass-toggle(target) => { root.tools-expression-bypass-toggle(target); }
        expression-bypass-adjust(target, action) => {
            root.tools-expression-bypass-adjust(target, action);
        }
        expression-save => { root.tools-expression-save(); }
        tempo-global <=> root.tempo-global;
        tab <=> root.settings-tab;
        section: root.tools-section;
        pedal-tab <=> root.pedal-tab;
        midi-tab <=> root.midi-tab;
        bt-devices: root.bt-devices;
        bt-picked(index) => { root.bt-picked(index); }
        bt-forget(index) => { root.bt-forget(index); }
        x: 0px; y: 0px; width: root.width; height: root.height;
        closed => { root.settings-open = false; }
        layout-mode: root.layout-mode;
        layout-tapped(mode) => { root.layout-tapped(mode); }
    }

    if root.model-open: ModelPicker {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: !root.kbd-open;
        title: root.model-list-title;
        items: root.model-list;
        menu-index <=> root.preset-menu-index;
        columns: root.portrait ? 2 : 3;
        content-height: root.model-list-height;
        current: root.model-list-current;
        initial-section: root.model-list-section;
        show-preset-numbers: root.list-kind == 3 || root.list-kind == 4 || root.list-kind == 5;
        show-preset-actions: root.list-kind == 3;
        two-line-names: root.list-kind >= 1 && root.list-kind <= 5;
        three-line-names: root.list-kind >= 3 && root.list-kind <= 5;
        picked(index) => {
            root.model-chosen(index);
            if root.list-kind == 3 {
                root.model-list-current = index;
            } else {
                root.model-open = false;
            }
        }
        preset-action-chosen(index, action) => { root.model-preset-action-chosen(index, action); }
        closed => { root.model-open = false; }
    }

    if root.scene-library-open && !root.model-open: ScenePanel {
        width: root.width; height: root.height;
        visible: !root.kbd-open;
        title: root.scene-title;
        menu-index <=> root.scene-menu-index;
        portrait: root.portrait;
        enabled: !root.connecting && !root.scene-library-busy;
        assigned: root.scene-assigned;
        dirty: root.scene-dirty;
        scenes: root.scene-library-scenes; scene: root.scene-library-scene;
        scene-recall(index) => { root.scene-library-scene-recall(index); }
        scene-store(index) => { root.scene-library-scene-store(index); }
        scene-rename(index) => { root.scene-library-scene-rename(index); }
        scene-clear(index) => { root.midi-clear-confirm = false; root.scene-library-scene-clear(index); }
        closed => { root.scene-library-open = false; }
    }

    if root.gig-open && root.page != 2: GigPanel {
        width: root.width; height: root.height;
        portrait: root.portrait;
        connected: !root.connecting;
        busy: root.scene-library-busy;
        preset: root.preset;
        notice: root.scene-library-notice;
        scenes: root.gig-scenes; scene-assigned: root.gig-scene-assigned; scene: root.gig-scene;
        scene-recall(index) => { root.gig-scene-recall(index); }
        tuner => { root.tuner-tapped(); }
        tempo => { root.tempo-tapped(); }
        editor => { root.gig-mode-set(false); }
    }

    if root.confirm-open: ConfirmDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: !root.kbd-open;
        title: root.confirm-title;
        message: root.confirm-message;
        accept-label: root.confirm-label;
        accept-fill: root.confirm-danger ? #f8281a : #1a3af8;
        accepted => {
            root.confirm-open = false;
            if root.midi-clear-confirm {
                root.midi-clear-confirm = false;
                root.midi-clear-all();
            } else if root.clear-confirm-kind != 0 {
                root.scene-library-clear-all(root.clear-confirm-kind);
                root.clear-confirm-kind = 0;
            } else {
                root.confirm-accepted();
            }
        }
        closed => {
            root.confirm-open = false; root.midi-clear-confirm = false;
            root.clear-confirm-kind = 0;
        }
    }

    if root.kbd-open: NameKeyboard {
        x: 0px; y: 0px; width: root.width; height: root.height;
        title: root.kbd-title;
        text: root.kbd-text;
        error: root.kbd-error;
        key(k) => { root.kbd-key(k); }
        accepted => {
            root.kbd-open = false;
            root.kbd-accepted();
        }
        closed => { root.kbd-open = false; root.scene-library-name-action = 0; }
    }

    if root.connecting && !root.usb-storage-open && !root.scene-library-open && !root.gig-open: ConnectingOverlay {
        amp-state: root.conn-amp;
        foot-state: root.conn-foot;
        loading: root.load-status;
        version: root.app-version;
        scene-library => { root.scene-library-opened(); }
        usb-storage => { root.usb-storage-requested(); }
    }

    if root.usb-storage-open: Rectangle {
        width: root.width;
        height: root.height;
        background: Surface.background;
        TouchArea {}
        VerticalLayout {
            padding: Surface.screen-margin;
            spacing: 16px;
            Text {
                text: "USB configuration drive";
                color: #ffffff;
                font-size: 26px;
                font-weight: 700;
            }
            Text {
                text: root.usb-storage-message;
                color: #ececec;
                font-size: 20px;
                wrap: word-wrap;
            }
            Rectangle { background: transparent; vertical-stretch: 1; }
            DialogButton {
                label: root.usb-storage-finished ? "Restart controller" : "Cancel USB edits";
                fill: #1a3af8;
                tapped => {
                    if root.usb-storage-finished { root.usb-storage-restart(); }
                    else { root.usb-storage-cancel(); }
                }
            }
        }
    }
}
