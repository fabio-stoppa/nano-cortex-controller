// Landscape matches the 800×480 scan. Portrait moves the chain to the top and
// the firmware rotates that taller layout into the same framebuffer.

// The software renderer embeds only fonts it can resolve at build time, so the
// bold face is bundled explicitly.
import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-Bold.ttf";

// One corner radius for every card, button, tab and popup (the former cell radius).
global Radius {
    out property <length> default: 12px;
}

component ParamCell inherits Rectangle {
    in property <string> name;
    in property <string> value: "-";
    in property <float> amount: 0;
    in property <bool> slider: false;
    in property <bool> bare: false;
    in property <bool> value-first: true;
    callback changed(float);
    callback tapped();
    callback double-tapped();
    height: 100px;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: root.bare ? transparent : #1e1e1e;
    border-width: 0px;
    border-radius: Radius.default;
    VerticalLayout {
        height: 100%;
        alignment: center;
        padding: root.slider ? 8px : 6px;
        // Text line boxes leave more room under the value than above the label.
        padding-top: (root.slider ? 8px : 6px) + 2px;
        spacing: 4px;
        if root.bare && root.value-first: Text {
            text: value;
            color: #ececec;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        if !root.bare: Text {
            text: name.to-uppercase();
            color: #909090;
            font-size: 17px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            Rectangle {
            height: 18px;
            background: #1e1e1e;
            border-color: #707070;
            border-width: 1px;
            border-radius: 3px;
            Rectangle {
                x: 0px;
                width: parent.width * amount;
                height: 100%;
                background: #b8c0c8;
                border-radius: 2px;
            }
        }
        }
        if !root.bare || !root.value-first: Text {
            text: value;
            color: #ececec;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
    property <bool> armed: false;
    property <bool> pressed: false;
    property <length> down-x: 0px;
    property <length> down-y: 0px;
    Timer {
        interval: 200ms;
        running: root.pressed && !root.armed;
        triggered => { root.armed = true; }
    }
    if root.slider: TouchArea {
        double-clicked => { root.double-tapped(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pressed = true;
                root.armed = false;
                root.down-x = self.mouse-x;
                root.down-y = self.mouse-y;
            }
            if (event.kind == PointerEventKind.move && root.pressed && !root.armed) {
                if (abs(self.mouse-x - root.down-x) > 14px && abs(self.mouse-x - root.down-x) > 2 * abs(self.mouse-y - root.down-y)) {
                    root.armed = true;
                }
            }
            if ((event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) && root.armed) {
                root.changed(clamp((self.mouse-x - 12px) / max(self.width - 24px, 1px), 0, 1));
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.pressed = false;
                root.armed = false;
            }
        }
    }
    if !root.slider: TouchArea {
        clicked => { root.tapped(); }
    }
}

component ChainTab inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    in property <bool> active: false;
    in property <bool> selected: false;
    callback tapped();
    callback held();
    callback double-tapped();
    property <bool> pressed: false;
    property <bool> held-sent: false;
    property <bool> tap-pending: false;
    background: active ? accent : #000000;
    border-width: selected ? 2px : 0px;
    border-color: #ffffff;
    border-radius: Radius.default;
    Text {
        text: label;
        color: active ? #ffffff : accent;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Timer {
        interval: 450ms;
        running: root.pressed && !root.held-sent;
        triggered => {
            root.held-sent = true;
            root.held();
        }
    }
    Timer {
        interval: 350ms;
        running: root.tap-pending;
        triggered => { root.tap-pending = false; }
    }
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pressed = true;
                root.held-sent = false;
            }
            if (event.kind == PointerEventKind.up) {
                if (!root.held-sent) {
                    if (root.tap-pending) {
                        root.tap-pending = false;
                        root.double-tapped();
                    } else {
                        root.tap-pending = true;
                        root.tapped();
                    }
                }
                root.pressed = false;
            }
            if (event.kind == PointerEventKind.cancel) {
                root.pressed = false;
            }
        }
    }
}

component ChainRail inherits Rectangle {
    in property <bool> horizontal: false;
    in property <int> page;
    in property <int> chain;
    in property <string> tab-0;
    in property <string> tab-1;
    in property <string> tab-3;
    in property <string> tab-4;
    in property <string> tab-5;
    in property <bool> on-0;
    in property <bool> on-1;
    in property <bool> on-3;
    in property <bool> on-4;
    in property <bool> on-5;
    callback chain-tapped(int);
    callback chain-held(int);
    callback chain-double(int);
    background: transparent;

    if !root.horizontal: VerticalLayout {
        spacing: 8px;
        padding-top: 2px;
        padding-bottom: 4px;
        ChainTab {
            label: tab-0;
            accent: #909090;
            active: on-0;
            selected: (root.page == 0 || root.page == 1) && root.chain == 0;
            vertical-stretch: 1;
            tapped => { root.chain-tapped(0); }
            held => { root.chain-held(0); }
            double-tapped => { root.chain-double(0); }
        }
        ChainTab {
            label: tab-1;
            accent: #909090;
            active: on-1;
            selected: (root.page == 0 || root.page == 1) && root.chain == 1;
            vertical-stretch: 1;
            tapped => { root.chain-tapped(1); }
            held => { root.chain-held(1); }
            double-tapped => { root.chain-double(1); }
        }
        ChainTab {
            label: "AMP";
            accent: #e85040;
            active: true;
            selected: (root.page == 0 || root.page == 1) && root.chain == 2;
            vertical-stretch: 1;
            tapped => { root.chain-tapped(2); }
            held => { root.chain-held(2); }
            double-tapped => { root.chain-double(2); }
        }
        ChainTab {
            label: tab-3;
            accent: #909090;
            active: on-3;
            selected: (root.page == 0 || root.page == 1) && root.chain == 3;
            vertical-stretch: 1;
            tapped => { root.chain-tapped(3); }
            held => { root.chain-held(3); }
            double-tapped => { root.chain-double(3); }
        }
        ChainTab {
            label: tab-4;
            accent: #909090;
            active: on-4;
            selected: (root.page == 0 || root.page == 1) && root.chain == 4;
            vertical-stretch: 1;
            tapped => { root.chain-tapped(4); }
            held => { root.chain-held(4); }
            double-tapped => { root.chain-double(4); }
        }
        ChainTab {
            label: tab-5;
            accent: #909090;
            active: on-5;
            selected: (root.page == 0 || root.page == 1) && root.chain == 5;
            vertical-stretch: 1;
            tapped => { root.chain-tapped(5); }
            held => { root.chain-held(5); }
            double-tapped => { root.chain-double(5); }
        }
    }

    if root.horizontal: HorizontalLayout {
        spacing: 4px;
        ChainTab {
            label: tab-0;
            accent: #909090;
            active: on-0;
            selected: (root.page == 0 || root.page == 1) && root.chain == 0;
            horizontal-stretch: 1;
            tapped => { root.chain-tapped(0); }
            held => { root.chain-held(0); }
            double-tapped => { root.chain-double(0); }
        }
        ChainTab {
            label: tab-1;
            accent: #909090;
            active: on-1;
            selected: (root.page == 0 || root.page == 1) && root.chain == 1;
            horizontal-stretch: 1;
            tapped => { root.chain-tapped(1); }
            held => { root.chain-held(1); }
            double-tapped => { root.chain-double(1); }
        }
        ChainTab {
            label: "AMP";
            accent: #e85040;
            active: true;
            selected: (root.page == 0 || root.page == 1) && root.chain == 2;
            horizontal-stretch: 1;
            tapped => { root.chain-tapped(2); }
            held => { root.chain-held(2); }
            double-tapped => { root.chain-double(2); }
        }
        ChainTab {
            label: tab-3;
            accent: #909090;
            active: on-3;
            selected: (root.page == 0 || root.page == 1) && root.chain == 3;
            horizontal-stretch: 1;
            tapped => { root.chain-tapped(3); }
            held => { root.chain-held(3); }
            double-tapped => { root.chain-double(3); }
        }
        ChainTab {
            label: tab-4;
            accent: #909090;
            active: on-4;
            selected: (root.page == 0 || root.page == 1) && root.chain == 4;
            horizontal-stretch: 1;
            tapped => { root.chain-tapped(4); }
            held => { root.chain-held(4); }
            double-tapped => { root.chain-double(4); }
        }
        ChainTab {
            label: tab-5;
            accent: #909090;
            active: on-5;
            selected: (root.page == 0 || root.page == 1) && root.chain == 5;
            horizontal-stretch: 1;
            tapped => { root.chain-tapped(5); }
            held => { root.chain-held(5); }
            double-tapped => { root.chain-double(5); }
        }
    }
}

component HeaderButton inherits Rectangle {
    in property <string> label;
    in property <bool> hot: false;
    in property <bool> light: false;
    in property <bool> choice: false;
    callback tapped();
    preferred-width: btn-text.preferred-width + 36px;
    min-width: max(72px, self.preferred-width);
    height: 52px;
    background: choice ? (hot ? #404040 : transparent) : (light ? #ffffff : (hot ? #1a3af8 : #000000));
    border-radius: Radius.default;
    btn-text := Text {
        text: label;
        color: choice ? (hot ? #ffffff : #666666) : (light ? #000000 : (hot ? #ffffff : #e0e0e0));
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.tapped(); }
    }
}

// Lives inside a vertical Flickable: it cancels the scroll offset so it stays put on screen.
component ScrollBar inherits Rectangle {
    in property <length> offset;
    in property <length> page;
    in property <length> total;
    property <length> thumb-height: max(32px, root.page * root.page / max(1px, root.total));
    visible: root.total > root.page + 1px;
    width: 6px;
    height: root.page;
    y: root.offset;
    background: #ffffff18;
    border-radius: 3px;
    Rectangle {
        y: (root.page - root.thumb-height) * root.offset / max(1px, root.total - root.page);
        height: root.thumb-height;
        background: #909090;
        border-radius: 3px;
    }
}

// Fades the content at the top and bottom edges when more is scrolled out of view.
// Lives inside a vertical Flickable, like ScrollBar.
component ScrollFade inherits Rectangle {
    in property <length> offset;
    in property <length> page;
    in property <length> total;
    y: root.offset;
    height: root.page;
    background: transparent;
    Rectangle {
        y: 0px;
        height: 28px;
        visible: root.offset > 1px;
        background: @linear-gradient(180deg, #1e1e1e 0%, #1e1e1e00 100%);
    }
    Rectangle {
        y: root.page - 28px;
        height: 28px;
        visible: root.offset < root.total - root.page - 1px;
        background: @linear-gradient(180deg, #1e1e1e00 0%, #1e1e1e 100%);
    }
}

// One settings line: bold label on the left, controls (@children) on the right.
component OptionRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> highlight: false;
    in property <length> label-width: 0px;
    height: 68px;
    background: highlight ? #1a3af8 : #262626;
    border-radius: Radius.default;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            text: root.label;
            color: #e0e0e0;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: root.label-width;
            max-width: root.label-width > 0px ? root.label-width : 100000px;
        }
        if root.value != "": Text {
            text: root.value;
            color: #ffffffb0;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
        if root.value != "": Rectangle { width: 10px; }
        @children
    }
}

export struct MidiRow {
    name: string,
    assigned: string,
    learning: bool,
}

export struct BtDevice {
    name: string,
    kind: string,
    // 0 nearby, 1 connecting, 2 connected
    state: int,
}

// Rune-style Bluetooth mark; the icon color shows connected / connecting / off.
component BluetoothButton inherits Rectangle {
    in property <bool> connected;
    in property <bool> busy;
    in property <bool> open;
    callback tapped();
    property <bool> lit: connected || busy;
    property <color> ink: connected ? #ffffff : (busy ? #1229a8 : #606060);
    width: 36px;
    height: 36px;
    background: #000000;
    border-radius: Radius.default;
    Image {
        x: 4px; y: 4px; width: 28px; height: 28px;
        source: @image-url("icons/bluetooth.png");
        colorize: ink;
    }
    TouchArea { clicked => { root.tapped(); } }
}

// Centers its child vertically so row items never need hand-tuned y offsets.
component VCenter inherits VerticalLayout {
    alignment: center;
}

// Shared popup header: square close button and title on the left, optional
// children (e.g. tabs) on the right, and a separator drawn over the bottom edge.
component PopupHeader inherits Rectangle {
    in property <string> title;
    callback closed();
    height: 58px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        // Pinned to the top so its gap to the popup edge equals the side padding.
        VerticalLayout {
            width: 42px;
            padding-top: 3px;
            alignment: start;
            Rectangle {
                width: 42px;
                height: 42px;
                background: #2a2a2a;
                border-radius: Radius.default;
                Image {
                    width: 26px;
                    height: 26px;
                    source: @image-url("icons/close.png");
                    colorize: #e0e0e0;
                }
                TouchArea { clicked => { root.closed(); } }
            }
        }
        // Same 48px band as the close button, so both share a vertical center.
        VerticalLayout {
            alignment: start;
            title-text := Text {
                height: 48px;
                text: root.title;
                color: #e0e0e0;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
    // z keeps the separator above the tabs and their underline.
    Rectangle {
        z: 100;
        y: parent.height - 2px;
        height: 2px;
        background: #3a3a3a;
    }
        // Children are parented to the header itself, so they place themselves with these.
    out property <length> tabs-x: 42px + 12px + title-text.preferred-width + 16px;
    out property <length> tabs-width: max(0px, root.width - self.tabs-x);
    @children
}

// Shared tab for every popup. The 2px gap is part of the tab so empty loop items add no spacing.
component PopupTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> shown: true;
    callback tapped();
    preferred-width: shown ? tab-text.preferred-width + 26px : 0px;
    min-width: self.preferred-width;
    max-width: self.preferred-width;
    horizontal-stretch: 0;
    visible: shown;
    Rectangle {
        width: parent.width - 2px;
        background: root.active ? #454545 : #151515;
        border-top-left-radius: Radius.default;
        border-top-right-radius: Radius.default;
        tab-text := Text {
            text: root.label;
            color: root.active ? #ffffff : #909090;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            y: parent.height - 4px;
            height: 4px;
            background: root.active ? #1a3af8 : transparent;
        }
        if root.shown: TouchArea { clicked => { root.tapped(); } }
    }
}

component BluetoothPicker inherits Rectangle {
    in property <[BtDevice]> devices;
    callback picked(int);
    callback closed();
    background: #000000b0;
    TouchArea { clicked => { root.closed(); } }
    Rectangle {
        width: min(root.width - 24px, 460px);
        height: min(root.height - 24px, 360px);
        background: #1e1e1e;
        border-radius: Radius.default;
        TouchArea {}
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            PopupHeader {
                title: "Bluetooth devices";
                closed => { root.closed(); }
            }
            Rectangle { height: 2px; }
            if root.devices.length == 0: Text {
                text: "Searching for Nano Cortex or FootCtrl / Chocolate...";
                color: #909090;
                font-size: 17px;
                wrap: word-wrap;
                vertical-alignment: center;
                vertical-stretch: 1;
            }
            for device[index] in root.devices: Rectangle {
                height: 52px;
                background: device.state == 2 ? #1a3af8 : #2a2a2a;
                border-color: device.state > 0 ? #1a3af8 : #3a3a3a;
                border-width: 1px;
                border-radius: Radius.default;
                TouchArea { clicked => { root.picked(index); } }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: device.name;
                            color: #ececec;
                            font-size: 19px;
                            overflow: elide;
                        }
                        Text { text: device.kind; color: #909090; font-size: 14px; }
                    }
                    Text {
                        text: device.state == 2 ? "Connected" : (device.state == 1 ? "Connecting..." : "Tap to connect");
                        color: device.state > 0 ? #ffffff : #909090;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

export struct ModelItem {
    name: string,
    header: bool,
    index: int,
    col: int,
    y: float,
    // Tab the entry belongs to; a header's `height` is its tab's content height.
    section: int,
    height: float,
}

component ModelPicker inherits Rectangle {
    in property <string> title;
    in property <[ModelItem]> items;
    in property <int> columns: 3;
    in property <float> content-height: 0;
    in property <int> current;
    in property <int> initial-section: 0;
    property <int> tab: 0;
    init => { root.tab = root.initial-section; }
    callback picked(int);
    callback closed();
    property <length> gap: 8px;
    background: #000000b0;
    TouchArea { clicked => { root.closed(); } }
    Rectangle {
        width: root.width - 24px;
        height: root.height - 24px;
        background: #1e1e1e;
        border-radius: Radius.default;
        TouchArea {}
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            // Tabs sit on the right; a list whose first header is empty (presets) has none.
            PopupHeader {
                title: root.title;
                closed => { root.closed(); }
                tab-flick := Flickable {
                    x: parent.tabs-x;
                    width: parent.tabs-width;
                    height: parent.height;
                    viewport-width: max(self.width, tab-row.preferred-width);
                    tab-row := HorizontalLayout {
                        x: 0px;
                        height: parent.height;
                        width: max(tab-flick.width, self.preferred-width);
                        alignment: end;
                        spacing: 0px;
                        for hdr in root.items: PopupTab {
                            label: hdr.header ? hdr.name : "";
                            shown: hdr.header && root.items[0].name != "";
                            active: hdr.section == root.tab;
                            tapped => { root.tab = hdr.section; }
                        }
                    }
                }
                Rectangle {
                    x: parent.tabs-x;
                    width: 28px;
                    height: parent.height - 4px;
                    visible: tab-flick.viewport-x < -1px;
                    background: @linear-gradient(90deg, #1e1e1e 0%, #1e1e1e00 100%);
                }
                Rectangle {
                    x: parent.tabs-x + parent.tabs-width - 28px;
                    width: 28px;
                    height: parent.height - 4px;
                    visible: tab-flick.viewport-x + tab-flick.width < tab-flick.viewport-width - 1px;
                    background: @linear-gradient(90deg, #1e1e1e00 0%, #1e1e1e 100%);
                }
            }
            Rectangle { height: 2px; }
            Rectangle {
                vertical-stretch: 1;
                // One scroll area per tab so each keeps its own content height.
                for hdr in root.items: Rectangle {
                    if hdr.header && hdr.section == root.tab: tab-list := Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-height: hdr.height * 1px;
                        for item in root.items: Rectangle {
                            property <length> cell: (parent.width - (tab-list.viewport-height > tab-list.height ? 16px : 0px) - (root.columns - 1) * root.gap) / root.columns;
                            x: item.col * (cell + root.gap);
                            y: item.y * 1px;
                            width: cell;
                            height: 68px;
                            visible: !item.header && item.section == hdr.section;
                            background: item.index == root.current ? #1a3af8 : #2a2a2a;
                            border-radius: Radius.default;
                            TouchArea { enabled: !item.header; clicked => { root.picked(item.index); } }
                            Text {
                                x: 12px;
                                width: parent.width - 24px;
                                text: item.header ? "" : item.name;
                                color: item.index == root.current ? #ffffff : #ececec;
                                font-size: 19px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        ScrollFade {
                            width: tab-list.width;
                            offset: -tab-list.viewport-y;
                            page: tab-list.height;
                            total: tab-list.viewport-height;
                        }
                        ScrollBar {
                            x: tab-list.width - 6px;
                            offset: -tab-list.viewport-y;
                            page: tab-list.height;
                            total: tab-list.viewport-height;
                        }
                    }
                }
                // Lists without tabs scroll as one block.
                if root.items.length > 0 && root.items[0].name == "": plain-list := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-height: root.content-height * 1px;
                    for item in root.items: Rectangle {
                        property <length> cell: (parent.width - (plain-list.viewport-height > plain-list.height ? 16px : 0px) - (root.columns - 1) * root.gap) / root.columns;
                        x: item.col * (cell + root.gap);
                        y: item.y * 1px;
                        width: cell;
                        height: 68px;
                        visible: !item.header;
                        background: item.index == root.current ? #1a3af8 : #2a2a2a;
                        border-radius: Radius.default;
                        TouchArea { enabled: !item.header; clicked => { root.picked(item.index); } }
                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            text: item.header ? "" : item.name;
                            color: item.index == root.current ? #ffffff : #ececec;
                            font-size: 19px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    ScrollFade {
                        width: plain-list.width;
                        offset: -plain-list.viewport-y;
                        page: plain-list.height;
                        total: plain-list.viewport-height;
                    }
                    ScrollBar {
                        x: plain-list.width - 6px;
                        offset: -plain-list.viewport-y;
                        page: plain-list.height;
                        total: plain-list.viewport-height;
                    }
                }
            }
        }
    }
}

// Gear mark.
component RefreshButton inherits Rectangle {
    in property <bool> spinning;
    callback tapped();
    width: 36px;
    height: 36px;
    background: #000000;
    border-radius: Radius.default;
    Image {
        x: 4px; y: 4px; width: 28px; height: 28px;
        source: @image-url("icons/refresh.png");
        colorize: root.spinning ? #ffffff : #b0b8c0;
        rotation-angle: root.spinning ? mod(animation-tick() / 900ms, 1) * 360deg : 0deg;
    }
    TouchArea { clicked => { root.tapped(); } }
}

component SettingsButton inherits Rectangle {
    in property <bool> open;
    callback tapped();
    width: 36px;
    height: 36px;
    background: #000000;
    border-radius: Radius.default;
    property <color> ink: open ? #e0e8f0 : #b0b8c0;
    Image {
        x: 4px; y: 4px; width: 28px; height: 28px;
        source: @image-url("icons/gear.png");
        colorize: root.ink;
    }
    TouchArea { clicked => { root.tapped(); } }
}

component HeaderBar inherits Rectangle {
    in property <bool> portrait;
    in property <int> page;
    in property <string> preset;
    in property <bool> model-enabled;
    in property <string> bpm-text;
    in property <bool> ble-on;
    in property <bool> bt-busy;
    in property <bool> bt-open;
    in property <bool> settings-shown;
    in property <bool> save-dirty: false;
    in property <bool> tempo-active: false;
    in property <bool> tempo-global: true;
    in property <int> bpm-value: 0;
    // Beat flash: jumps to 1 on every beat and fades back out.
    property <float> beat-glow: 0;
    callback tempo-tapped();
    callback bt-tapped();
    callback preset-list-tapped();
    callback settings-tapped();
    callback refresh-tapped();
    in property <bool> refreshing;
    background: transparent;
    beat := Timer {
        interval: root.bpm-value > 0 ? 60000ms / root.bpm-value : 1000ms;
        running: root.bpm-value > 0;
        triggered => {
            root.beat-glow = 1;
            fade.running = true;
        }
    }
    fade := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            root.beat-glow = 0;
            self.running = false;
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 8px;
        // Both side groups share one width so the preset name stays centered.
        VCenter {
            width: portrait ? 134px : 214px;
            TouchArea {
                height: 44px;
                clicked => { root.tempo-tapped(); }
                HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    VCenter { Rectangle {
                        width: 20px;
                        height: 20px;
                        // Flashes on every beat; green while tapping.
                        property <color> tint: root.beat-glow > 0.5
                            ? (root.tempo-active ? #3dcc7a : #ffffff)
                            : (root.tempo-active ? #1c5c3a : #404040);
                        animate tint { duration: 120ms; easing: ease-out; }
                        if root.tempo-global: Rectangle {
                            border-width: 2.5px;
                            border-color: parent.tint;
                            border-radius: 10px;
                        }
                        if root.tempo-global: Rectangle {
                            x: 6px; width: 8px;
                            border-width: 2px;
                            border-color: parent.tint;
                            border-radius: 4px;
                        }
                        if root.tempo-global: Rectangle {
                            y: 8.75px; height: 2.5px;
                            background: parent.tint;
                        }
                        if !root.tempo-global: Rectangle {
                            x: 4px; y: 4px; width: 12px; height: 12px;
                            background: parent.tint;
                            border-radius: 6px;
                        }
                    } }
                    Text {
                        text: bpm-text;
                        color: root.tempo-active ? #3dcc7a : #c8c8c8;
                        font-size: portrait ? 18px : 21px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
            }
        }
        VCenter { horizontal-stretch: 1; TouchArea {
            height: 44px;
            clicked => { root.preset-list-tapped(); }
            Text {
                text: preset;
                color: model-enabled ? #ececec : #606060;
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        } }
        HorizontalLayout {
            alignment: end;
            spacing: portrait ? 8px : 14px;
            width: portrait ? 134px : 214px;
            VCenter { BluetoothButton {
                connected: ble-on;
                busy: bt-busy;
                open: bt-open;
                tapped => { root.bt-tapped(); }
            } }
            VCenter { RefreshButton {
                spinning: root.refreshing;
                tapped => { root.refresh-tapped(); }
            } }
            VCenter { SettingsButton {
                open: root.settings-shown;
                tapped => { root.settings-tapped(); }
            } }
        }
    }
}

component SourceCard inherits Rectangle {
    in property <string> value;
    in property <string> slot;
    in property <bool> active: false;
    in property <bool> cab-icon: false;
    callback tapped();
    height: 72px;
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    background: #000000;
    border-color: #292d30;
    border-width: 1px;
    border-radius: Radius.default;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 9px;
        padding-right: 9px;
        spacing: 10px;
        VerticalLayout {
            width: 36px;
            height: 100%;
            alignment: center;
            Image {
                width: 36px;
                height: 36px;
                source: root.cab-icon ? @image-url("icons/cab.png") : @image-url("icons/capture.png");
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            alignment: center;
            spacing: 0px;
            HorizontalLayout {
                width: 100%;
                Text {
                    text: root.slot;
                    color: #858b90;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            Text {
                text: value;
                color: active ? #ececec : #74797d;
                font-size: 19px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
    TouchArea {
        clicked => { root.tapped(); }
    }
}

component AmpPanel inherits Rectangle {
    in property <bool> portrait;
    in property <string> capture-title;
    in property <string> capture-value;
    in property <string> capture-slot;
    in property <bool> capture-active;
    in property <string> cab-value;
    in property <string> cab-slot;
    in property <bool> cab-active;
    in property <string> gate-text;
    in property <float> gate-amount;
    in property <string> gate-amnt-text;
    in property <float> gate-amnt-amount;
    in property <string> gain-text;
    in property <float> gain-amount;
    in property <string> cap-text;
    in property <float> cap-amount;
    in property <string> master-text;
    in property <float> master-amount;
    in property <string> bass-text;
    in property <float> bass-amount;
    in property <string> mid-text;
    in property <float> mid-amount;
    in property <string> treble-text;
    in property <float> treble-amount;
    in property <string> cab-output-text;
    in property <float> cab-output-amount;
    in property <string> cab-high-pass-text;
    in property <float> cab-high-pass-amount;
    in property <string> cab-low-pass-text;
    in property <float> cab-low-pass-amount;
    callback slider-moved(int, float);
    callback cab-slider-moved(int, float);
    callback gate-tapped();
    callback capture-tapped();
    callback cab-tapped();
    background: transparent;
    HorizontalLayout {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: 72px;
        spacing: 4px;
        SourceCard {
            value: root.capture-value;
            slot: root.capture-slot;
            active: root.capture-active;
            tapped => { root.capture-tapped(); }
        }
        SourceCard {
            value: root.cab-value;
            slot: root.cab-slot;
            active: root.cab-active;
            cab-icon: true;
            tapped => { root.cab-tapped(); }
        }
    }
    VerticalLayout {
        y: 78px;
        alignment: start;
        padding: 2px;
        spacing: 4px;
        if !root.portrait: HorizontalLayout {
            width: 100%;
            height: 100px;
            spacing: 4px;
            ParamCell {
                horizontal-stretch: 1;
                name: "Input Gate";
                value: gate-text;
                amount: gate-amount;
                tapped => { root.gate-tapped(); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Gate Amnt";
                value: gate-amnt-text;
                amount: gate-amnt-amount;
                changed(v) => { root.slider-moved(6, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Gain";
                value: gain-text;
                amount: gain-amount;
                changed(v) => { root.slider-moved(0, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Capture Lv";
                value: cap-text;
                amount: cap-amount;
                changed(v) => { root.slider-moved(5, v); }
            }
        }
        if !root.portrait: HorizontalLayout {
            width: 100%;
            height: 100px;
            spacing: 4px;
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Master Lv";
                value: master-text;
                amount: master-amount;
                changed(v) => { root.slider-moved(1, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Bass";
                value: bass-text;
                amount: bass-amount;
                changed(v) => { root.slider-moved(2, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Mid";
                value: mid-text;
                amount: mid-amount;
                changed(v) => { root.slider-moved(3, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Treble";
                value: treble-text;
                amount: treble-amount;
                changed(v) => { root.slider-moved(4, v); }
            }
        }
        if root.portrait: HorizontalLayout {
            width: 100%;
            height: 100px;
            spacing: 4px;
            ParamCell {
                horizontal-stretch: 1;
                name: "Input Gate";
                value: gate-text;
                amount: gate-amount;
                tapped => { root.gate-tapped(); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Gate Amnt";
                value: gate-amnt-text;
                amount: gate-amnt-amount;
                changed(v) => { root.slider-moved(6, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Gain";
                value: gain-text;
                amount: gain-amount;
                changed(v) => { root.slider-moved(0, v); }
            }
        }
        if root.portrait: HorizontalLayout {
            width: 100%;
            height: 100px;
            spacing: 4px;
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Capture Lv";
                value: cap-text;
                amount: cap-amount;
                changed(v) => { root.slider-moved(5, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Master Lv";
                value: master-text;
                amount: master-amount;
                changed(v) => { root.slider-moved(1, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Bass";
                value: bass-text;
                amount: bass-amount;
                changed(v) => { root.slider-moved(2, v); }
            }
        }
        if root.portrait: HorizontalLayout {
            width: 100%;
            height: 100px;
            spacing: 4px;
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Mid";
                value: mid-text;
                amount: mid-amount;
                changed(v) => { root.slider-moved(3, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: true;
                name: "Treble";
                value: treble-text;
                amount: treble-amount;
                changed(v) => { root.slider-moved(4, v); }
            }
            Rectangle {
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            width: 100%;
            height: 100px;
            spacing: 4px;
            ParamCell {
                horizontal-stretch: 1;
                slider: root.cab-active;
                name: "Cab Output";
                value: root.cab-output-text;
                amount: root.cab-output-amount;
                changed(v) => { root.cab-slider-moved(0, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: root.cab-active;
                name: "High Pass";
                value: root.cab-high-pass-text;
                amount: root.cab-high-pass-amount;
                changed(v) => { root.cab-slider-moved(1, v); }
            }
            ParamCell {
                horizontal-stretch: 1;
                slider: root.cab-active;
                name: "Low Pass";
                value: root.cab-low-pass-text;
                amount: root.cab-low-pass-amount;
                changed(v) => { root.cab-slider-moved(2, v); }
            }
            if !root.portrait: Rectangle {
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
            }
        }
    }
}

