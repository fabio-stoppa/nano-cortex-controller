    callback model-list-tapped();
    callback model-stepped(int);
    callback param-changed(int, float);
    property <length> cell-width: (root.width - 4px - 24px) / 4;
    background: transparent;
    clip: true;
    Flickable {
        y: 0px;
        width: 100%;
        height: root.height;
        viewport-y: 0px;
        VerticalLayout {
            width: parent.width;
            alignment: start;
            padding: 2px;
            padding-top: 0px;
            spacing: 8px;
            if root.n0 != "-" || root.n1 != "-" || root.n2 != "-" || root.n3 != "-": HorizontalLayout {
                width: 100%;
                spacing: 8px;
                alignment: start;
                if root.n0 != "-": FxParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n0; value: root.v0; amount: root.a0;
                    changed(v) => { root.param-changed(0, v); }
                }
                if root.n1 != "-": FxParamCell {
                    horizontal-stretch: 0; width: root.cell-width; slider: true; name: root.n1; value: root.v1; amount: root.a1;
