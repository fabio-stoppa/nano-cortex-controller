// Desktop-only wrapper around AppWindow: sample data, screen navigation and popup toggles.
// Not part of the firmware build. Run with ./firmware/preview.sh
import { AppWindow, ModelItem, BtDevice, MidiRow } from "app.slint";

component DevChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 24px;
    width: t.preferred-width + 16px;
    border-radius: 12px;
    background: root.active ? #1a3af8 : #000000c0;
    t := Text {
        text: root.label;
        color: white;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component Preview inherits AppWindow {
    // Preview edits are temporary and never communicate with the Nano.
    in-out property <string> popup: "none";
    in-out property <bool> tap-mode: false;
    in-out property <bool> preview-portrait: false;
    out property <bool> preview-fx-on: root.on-0;
    portrait: root.preview-portrait;
    property <int> demo-save-kind: 0;
    property <int> demo-save-slot: 0;
    property <[int]> demo-block-models: [0, 1, 2, 3, 4];
    property <int> demo-block-index: root.chain == 0 ? 0 : root.chain == 1 ? 1 : root.chain == 3 ? 2 : root.chain == 4 ? 3 : 4;
    property <int> demo-model-index: root.demo-block-models[root.demo-block-index];
    property <[string]> demo-model-names: ["Analog Delay", "Room", "Gentle chorus", "Compressor", "Parametric EQ", "Digital Delay"];
    property <[string]> demo-scenes: ["Crystal Clean", "Lead", "Ambient", "", "Wide Ambient Pad", "Solo"];
    scene-library-open: root.popup == "scenes";
    gig-open: root.popup == "gig";
    usb-storage-requested => {
        root.popup = "usb";
    }
    usb-storage-cancel => {
        root.usb-storage-finished = true;
        root.usb-storage-message = "Preview USB edits discarded.";
    }
    usb-storage-restart => { root.popup = "none"; }
    changed popup => {
        root.usb-storage-open = root.popup == "usb";
        if root.popup == "usb" {
            root.usb-storage-finished = false;
            root.usb-storage-message = "Preview only - no USB drive is exposed. Firmware exports midi.json, scenes.json and preferences.json; safely eject to import, then restart.";
        }
        root.scene-library-open = root.popup == "scenes";
        root.gig-open = root.popup == "gig";
        root.settings-open = root.popup == "settings" || root.popup == "bluetooth"
            || root.popup == "midi" || root.popup == "pedals";
        root.model-open = root.popup == "preset" || root.popup == "preset-menu" || root.popup == "model"
            || root.popup == "capture" || root.popup == "cab" || root.popup == "library";
        root.kbd-open = root.popup == "rename" || root.demo-save-kind != 0;
    }
    scene-preset: 2;
    scene-title: "2: Summer Drive scenes";
    scene-assigned: [root.demo-scenes[0] != "", root.demo-scenes[1] != "", root.demo-scenes[2] != "", root.demo-scenes[3] != "",
        root.demo-scenes[4] != "", root.demo-scenes[5] != ""];
    scene-library-scenes: [
        root.demo-scenes[0] == "" ? "(empty)" : root.demo-scenes[0],
        root.demo-scenes[1] == "" ? "(empty)" : root.demo-scenes[1],
        root.demo-scenes[2] == "" ? "(empty)" : root.demo-scenes[2],
        root.demo-scenes[3] == "" ? "(empty)" : root.demo-scenes[3],
        root.demo-scenes[4] == "" ? "(empty)" : root.demo-scenes[4],
        root.demo-scenes[5] == "" ? "(empty)" : root.demo-scenes[5],
    ];
    scene-library-scene: 0;
    scene-label: root.scene-library-scene >= 0 ? root.demo-scenes[root.scene-library-scene] + (root.scene-dirty ? " *" : "") : "Scene";
    scene-library-notice: "Preview only - saved changes last until the preview closes.";
    gig-scenes: root.scene-library-scenes;
    gig-scene-assigned: root.scene-assigned;
    gig-scene: root.scene-library-scene;
    callback demo-recall-scene(int);
    demo-recall-scene(index) => {
        root.scene-library-scene = index;
        root.scene-dirty = false;
    }
    callback demo-name(int, int);
    demo-name(kind, index) => {
        root.demo-save-kind = kind;
        root.demo-save-slot = index;
        root.kbd-title = kind == 1 ? "Save scene" : "Rename scene";
        root.kbd-text = root.demo-scenes[index] == "" ? "Scene " + (index + 1) : root.demo-scenes[index];
        root.kbd-error = "";
        root.kbd-open = true;
    }
    property <[ModelItem]> preset-items: [
        { name: "1-12", header: true, index: -1, col: 0, y: 0, section: 0, height: 204 },
        { name: "Clean", header: false, index: 1, col: 0, y: 0, section: 0, height: 0 },
        { name: "Summer Drive", header: false, index: 2, col: 1, y: 0, section: 0, height: 0 },
        { name: "Heavy Lead 1", header: false, index: 3, col: 2, y: 0, section: 0, height: 0 },
        { name: "Ambient", header: false, index: 4, col: 0, y: 102, section: 0, height: 0 },
    ];
    property <[ModelItem]> model-items: [
        { name: "Clean", header: true, index: -1, col: 0, y: 0, section: 0, height: 152 },
        { name: "Rew D20 Clean", header: false, index: 0, col: 0, y: 0, section: 0, height: 0 },
        { name: "Rew D20 Clean NF53", header: false, index: 1, col: 1, y: 0, section: 0, height: 0 },
        { name: "Twin Reverb", header: false, index: 2, col: 2, y: 0, section: 0, height: 0 },
        { name: "Deluxe", header: false, index: 3, col: 0, y: 76, section: 0, height: 0 },
        { name: "Crunch", header: true, index: -1, col: 0, y: 0, section: 1, height: 152 },
        { name: "Plexi 100", header: false, index: 4, col: 0, y: 0, section: 1, height: 0 },
        { name: "JCM800", header: false, index: 5, col: 1, y: 0, section: 1, height: 0 },
        { name: "AC30 Top Boost", header: false, index: 6, col: 2, y: 0, section: 1, height: 0 },
        { name: "Bluesbreaker", header: false, index: 7, col: 0, y: 76, section: 1, height: 0 },
        { name: "High Gain", header: true, index: -1, col: 0, y: 0, section: 2, height: 76 },
        { name: "5150", header: false, index: 8, col: 0, y: 0, section: 2, height: 0 },
    ];
    property <[ModelItem]> fx-model-items: [
        { name: "Models", header: true, index: -1, col: 0, y: 0, section: 0, height: 152 },
        { name: "Analog Delay", header: false, index: 0, col: 0, y: 0, section: 0, height: 0 },
        { name: "Room", header: false, index: 1, col: 1, y: 0, section: 0, height: 0 },
        { name: "Gentle chorus", header: false, index: 2, col: 2, y: 0, section: 0, height: 0 },
        { name: "Compressor", header: false, index: 3, col: 0, y: 76, section: 0, height: 0 },
        { name: "Parametric EQ", header: false, index: 4, col: 1, y: 76, section: 0, height: 0 },
        { name: "Digital Delay", header: false, index: 5, col: 2, y: 76, section: 0, height: 0 },
    ];

    connecting: root.popup == "connecting";
    conn-amp: 2;
    load-status: "Loading presets...";
    app-version: "0.2.0";
    conn-foot: 0;
    settings-open: root.popup == "settings" || root.popup == "bluetooth";
    model-open: root.popup == "preset" || root.popup == "preset-menu" || root.popup == "model" || root.popup == "capture"
        || root.popup == "cab" || root.popup == "library";
    list-kind: root.popup == "preset" || root.popup == "preset-menu" ? 3 : 0;
    preset-menu-index: root.popup == "preset-menu" ? 2 : -1;
    kbd-open: root.popup == "rename" || root.demo-save-kind != 0;
    kbd-title: "Rename preset 2";
    kbd-text: "Summer Drive";

    preset: "Summer Drive";
    ble-on: true;
    model: root.chain == 2 ? "Rew D20 Clean NF53" : root.demo-model-names[root.demo-model-index];
    model-enabled: true;
    capture-title: "CAPTURE · AMP HEAD";
    capture-value: "Rew D20 Clean NF53";
    capture-slot: "High Gain - Slot 3";
    capture-active: true;
    cab-value: "810 Amped VT Aln 70s";
    cab-slot: "Slot 2";
    cab-active: true;
    save-dirty: true;
    gate-text: "OFF";
    gate-amnt-text: "0";
    gain-text: "5.0";
    gain-amount: 0.5;
    cap-text: "0.0 dB";
    cap-amount: 0.5;
    master-text: "7.0";
    master-amount: 0.7;
    bass-text: "4.0";
    bass-amount: 0.4;
    mid-text: "6.0";
    mid-amount: 0.6;
    treble-text: "5.0";
    treble-amount: 0.5;
    cab-output-text: "0.0 dB";
    cab-output-amount: 0.66;
    cab-high-pass-text: "80 Hz";
    cab-high-pass-amount: 0.08;
    cab-low-pass-text: "9.5 kHz";
    cab-low-pass-amount: 0.45;
    fx-n0: "Mix";
    fx-v0: "32%";
    fx-a0: 0.32;
    fx-n1: "Feedback";
    fx-v1: "48%";
    fx-a1: 0.48;
    fx-n2: "High Pass";
    fx-v2: "120 Hz";
    fx-a2: 0.18;
    fx-n3: "Low Pass";
    fx-v3: "6.2 kHz";
    fx-a3: 0.72;
    fx-n4: "Ping Pong";
    fx-v4: "Off";
    fx-n5: "Delay Time";
    fx-v5: "420 ms";
    fx-a5: 0.38;
    fx-n6: "Mod Rate";
    fx-v6: "0.8 Hz";
    fx-a6: 0.24;
    fx-n7: "Mod Depth";
    fx-v7: "21%";
    fx-a7: 0.21;
    tab-0: "DLY";
    tab-1: "REV";
    tab-3: "CHO";
    tab-4: "COMP";
    tab-5: "EQ";
    category-0: 9;
    category-1: 10;
    category-3: 8;
    category-4: 3;
    category-5: 5;
    on-0: true;
    on-1: true;
    on-4: true;
    tuner-active: root.page == 2;
    tuner-has-pitch: true;
    tuner-note: "F#";
    tuner-cents: "+12.0 ct";
    tuner-pos: 0.62;
    bpm-text: "120 BPM";
    tempo-bpm-value: 120;
    tempo-active: root.tap-mode;
    tools-jack-mode: "Expression";
    tools-jack-expression: true;
    tools-usb-level: "-6 dB";
    tools-usb-amount: 0.85;
    tools-cab-settings: "Cab on · IR 2 · Output 0.0 dB";
    tools-expression-summary: "EXP 1 → Gain · EXP 2 → Master";
    tools-calibration-status: "Idle";
    tools-protocol-status: "Connected";
    tools-meter-input: "-18 dB";
    tools-meter-output: "-12 dB";
    tools-meter-expression: "64%";
    tools-meter-input-amount: 0.55;
    tools-meter-output-amount: 0.7;
    tools-meter-expression-amount: 0.64;
    bt-devices: [
        { name: "Nano Cortex", kind: "Amp", state: 2 },
        { name: "Nano Cortex 2", kind: "Amp", state: 1 },
        { name: "FootCtrl BLE", kind: "MIDI", state: 0 },
    ];
    property <[MidiRow]> demo-midi-controls: [
        { index: 1, name: "Tuner", assigned: "CC 20", learning: false },
        { index: 2, name: "Tap tempo", assigned: "Press a footswitch…", learning: true },
    ];
    property <[MidiRow]> demo-midi-presets: [
        { index: 3, name: "Preset up", assigned: "Not assigned", learning: false },
        { index: 4, name: "Preset down", assigned: "Not assigned", learning: false },
    ];
    property <[MidiRow]> demo-midi-amp: [
        { index: 5, name: "Amp gain (CC)", assigned: "CC 7", learning: false },
        { index: 6, name: "Cab level (CC)", assigned: "", learning: false },
    ];
    property <[MidiRow]> demo-midi-fx: [
        { index: 0, name: "FX 1 on/off", assigned: "Note 60", learning: false },
        { index: 7, name: "FX 1 mix (CC)", assigned: "", learning: false },
    ];
    midi-rows: root.midi-tab == 0 ? root.demo-midi-controls
        : root.midi-tab >= 1 && root.midi-tab <= 6 ? root.demo-midi-presets
        : root.midi-tab == 7 ? root.demo-midi-amp : root.demo-midi-fx;
    midi-last: "CC 20 = 127";
    model-list-title: root.popup == "preset" ? "Presets"
        : root.popup == "preset-menu" ? "Presets · action menu"
        : root.popup == "capture" ? "Captures"
        : root.popup == "cab" ? "Cabs"
        : root.popup == "library" ? "Library" : "Models";
    model-list-height: 152;
    model-list-current: root.popup == "preset" || root.popup == "preset-menu" ? 2 : root.page == 1 ? root.demo-model-index : 1;
    model-list-section: 0;
    model-list: root.popup == "preset" || root.popup == "preset-menu" ? root.preset-items
        : root.popup == "model" && root.page == 1 ? root.fx-model-items : root.model-items;

    chain-tapped(index) => {
        root.popup = "none";
        root.chain = index;
        root.page = index == 2 ? 0 : 1;
    }
    chain-double(index) => {
        if index != 2 {
            root.chain = index;
            root.page = 1;
            root.popup = "model";
        }
    }
    chain-held(index) => {
        if index == 0 { root.on-0 = !root.on-0; }
        else if index == 1 { root.on-1 = !root.on-1; }
        else if index == 3 { root.on-3 = !root.on-3; }
        else if index == 4 { root.on-4 = !root.on-4; }
        else if index == 5 { root.on-5 = !root.on-5; }
    }
    scene-library-opened => { root.popup = "scenes"; }
    header-scene-action(action) => {
        if action == 0 { root.scene-library-scene-rename(root.scene-library-scene); }
        else if action == 1 { root.scene-library-scene-store(root.scene-library-scene); }
        else { root.scene-library-scene-clear(root.scene-library-scene); }
    }
    scene-library-scene-recall(index) => { root.demo-recall-scene(index); }
    gig-scene-recall(index) => { root.demo-recall-scene(index); }
    scene-library-scene-store(index) => { root.demo-name(1, index); }
    scene-library-scene-rename(index) => { root.demo-name(4, index); }
    scene-library-scene-clear(index) => {
        root.demo-scenes[index] = "";
        if root.scene-library-scene == index { root.scene-library-scene = -1; root.scene-dirty = false; }
    }
    param-changed(index, amount) => { root.scene-dirty = root.scene-library-scene >= 0; }
    slider-moved(index, amount) => { root.scene-dirty = root.scene-library-scene >= 0; }
    tuner-tapped => { root.page = root.page == 2 ? (root.chain == 2 ? 0 : 1) : 2; }
    tempo-tapped => { root.tap-mode = !root.tap-mode; }
    tools-opened => { root.popup = root.tools-section == 2 ? "midi" : root.tools-section == 1 ? "pedals" : "settings"; }
    autosave-toggled(enabled) => {
        root.autosave-enabled = enabled;
        root.autosave-status = enabled ? "Preview only - no automatic saves are sent to the Nano." : "";
    }
    midi-clear-all => {
        root.demo-midi-controls[0].assigned = "";
        root.demo-midi-controls[0].learning = false;
        root.demo-midi-controls[1].assigned = "";
        root.demo-midi-controls[1].learning = false;
        root.demo-midi-presets[0].assigned = "";
        root.demo-midi-presets[1].assigned = "";
        root.demo-midi-amp[0].assigned = "";
        root.demo-midi-amp[1].assigned = "";
        root.demo-midi-fx[0].assigned = "";
        root.demo-midi-fx[1].assigned = "";
        root.clear-completed(true, "MIDI bindings cleared (preview only)");
    }
    scene-library-clear-all(kind) => {
        root.demo-scenes = ["", "", "", "", "", "", "", ""];
        root.scene-library-scene = -1;
        root.scene-dirty = false;
        root.clear-completed(true, "All scenes cleared (preview only)");
    }
    preferences-clear-all => {
        root.layout-mode = 0;
        root.preview-portrait = false;
        root.autosave-enabled = false;
        root.autosave-status = "";
        root.clear-completed(true, "Preferences reset: landscape, Autosave off (preview only)");
    }
    preset-list-tapped => { root.popup = "preset"; }
    model-preset-action-chosen(index, action) => {
        root.preset-menu-index = -1;
        if (action == 0) {
            root.popup = "rename";
        } else if (action == 3) {
            root.confirm-title = "Delete preset " + index + "?";
            root.confirm-message = "“" + (index == 2 ? "Summer Drive" : "Selected preset") + "” will be removed from the pedal.";
            root.confirm-label = "Delete";
            root.confirm-danger = true;
            root.confirm-open = true;
        }
    }
    kbd-key(key) => { }
    kbd-accepted => {
        if root.demo-save-kind == 1 || root.demo-save-kind == 4 {
            root.demo-scenes[root.demo-save-slot] = root.kbd-text;
            if root.demo-save-kind == 1 { root.demo-recall-scene(root.demo-save-slot); }
        } else {
            root.popup = "none";
        }
        root.demo-save-kind = 0;
        root.kbd-open = false;
    }
    changed kbd-open => {
        if !root.kbd-open {
            root.demo-save-kind = 0;
            if root.popup == "rename" { root.popup = "none"; }
        }
    }
    model-list-tapped => { root.popup = "model"; }
    model-stepped(delta) => {
        root.demo-block-models[root.demo-block-index] =
            mod(root.demo-model-index + delta + root.demo-model-names.length, root.demo-model-names.length);
    }
    model-chosen(index) => {
        if root.page == 1 { root.demo-block-models[root.demo-block-index] = clamp(index, 0, root.demo-model-names.length - 1); }
        root.popup = "none";
    }
    capture-list-tapped => { root.popup = "capture"; }
    cab-list-tapped => { root.popup = "cab"; }
    library-tapped => { root.popup = "library"; }
    layout-tapped(mode) => {
        root.layout-mode = mode;
        root.popup = "none";
    }
    // Pickers also close themselves through settings-open / model-open, so mirror that here.
    changed settings-open => {
        if !root.settings-open && (root.popup == "settings" || root.popup == "bluetooth"
            || root.popup == "midi" || root.popup == "pedals") { root.popup = "none"; }
    }
    changed model-open => {
        if !root.model-open && (root.popup == "preset" || root.popup == "preset-menu"
            || root.popup == "model" || root.popup == "capture" || root.popup == "cab" || root.popup == "library") {
            root.popup = "none";
        }
    }
    changed scene-library-open => { if !root.scene-library-open && root.popup == "scenes" { root.popup = root.gig-open ? "gig" : "none"; } }
    changed gig-open => {
        if root.gig-open { root.popup = "gig"; }
        else if root.popup == "gig" { root.popup = "none"; }
    }

    // Dev bar: jump straight to any screen or popup.
    VerticalLayout {
        x: (root.width - self.preferred-width) / 2;
        y: root.height - 86px;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            for p in [
                { l: "Amp", page: 0, chain: 2 },
                { l: "FX", page: 1, chain: 0 },
                { l: "Tuner", page: 2, chain: 2 },
            ]: DevChip {
                label: p.l;
                active: root.popup == "none" && root.page == p.page;
                clicked => {
                    root.popup = "none";
                    root.chain = p.chain;
                    root.page = p.page;
                }
            }
            for p in [{ l: "Scenes", v: "scenes" }, { l: "Gig", v: "gig" }]: DevChip {
                label: p.l;
                active: root.popup == p.v;
                clicked => {
                    root.popup = root.popup == p.v ? "none" : p.v;
                }
            }
            DevChip {
                label: "Edited";
                active: root.scene-dirty;
                clicked => {
                    root.save-dirty = !root.save-dirty;
                    root.scene-dirty = !root.scene-dirty;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            for p in [
                { l: "BT", v: "bluetooth" },
                { l: "Presets", v: "preset" },
                { l: "Dots", v: "preset-menu" },
                { l: "Rename", v: "rename" },
                { l: "Models", v: "model" },
            ]: DevChip {
                label: p.l;
                active: root.popup == p.v;
                clicked => {
                    root.popup = root.popup == p.v ? "none" : p.v;
                    if p.v == "bluetooth" { root.tools-section = 0; root.settings-tab = 4; }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            for p in [
                { l: "Capture", v: "capture" },
                { l: "Cabs", v: "cab" },
                { l: "Welcome", v: "connecting" },
                { l: "Settings", v: "settings" },
                { l: "USB", v: "usb" },
            ]: DevChip {
                label: p.l;
                active: root.popup == p.v;
                clicked => {
                    root.popup = root.popup == p.v ? "none" : p.v;
                    if p.v == "settings" { root.tools-section = 0; root.settings-tab = 0; }
                }
            }
        }
    }
}

// Same preview on the 480x800 portrait panel.
export component PreviewPortrait inherits Preview {
    preview-portrait: true;
    layout-mode: 1;
    preferred-width: 480px;
    preferred-height: 800px;
}
